<Page
    x:Class="networker.SettingsPg"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="20,16,20,12" Spacing="16" MaxWidth="680" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Settings" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="AI provider connection, global prompt defaults, Network Config preferences, and appearance."/>
            </StackPanel>

            <!-- ===================== AI Provider ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="AI Provider" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="Select the AI provider. Ollama runs locally with no cloud credentials. Grok and Gemini are configured through environment variables (see .env.example)."/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Active provider" Style="{StaticResource FieldLabelTextStyle}"/>
                        <ComboBox x:Name="ProviderComboBox" SelectionChanged="ProviderComboBox_SelectionChanged" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Ollama Connection ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Ollama Connection" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="API Endpoint" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="EndpointTextBox" PlaceholderText="http://localhost:11434" LostFocus="EndpointTextBox_LostFocus"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="API Key" Style="{StaticResource FieldLabelTextStyle}"/>
                        <PasswordBox x:Name="ApiKeyPasswordBox" PlaceholderText="Optional" LostFocus="ApiKeyPasswordBox_LostFocus"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Default Model" Style="{StaticResource FieldLabelTextStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox x:Name="ModelComboBox" Width="300" SelectionChanged="ModelComboBox_SelectionChanged" IsEnabled="False"/>
                            <Button x:Name="RefreshButton" Content="Refresh Models" Click="RefreshButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="24" Height="24" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock x:Name="ConnectionStatusText" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Global Prompt ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Global Prompt" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="The instructions below are automatically prepended to every request sent to the selected model. Both fields are optional."/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="System Prompt" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="SystemPromptTextBox" PlaceholderText="e.g. You are a helpful coding assistant."
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" LostFocus="SystemPromptTextBox_LostFocus"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Custom Instructions / Training" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="CustomInstructionsTextBox" PlaceholderText="e.g. Always respond with concise, code-first answers."
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" LostFocus="CustomInstructionsTextBox_LostFocus"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SavePromptButton" Content="Save" Click="SavePromptButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button x:Name="ResetPromptButton" Content="Reset" Click="ResetPromptButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <TextBlock x:Name="PromptStatusText" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Network Config ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Network Config" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="Default vendor preselected in the Network Config Generate tab. The vault (vault.dat) and custom templates (custom_templates.json) live in the data folder below; changing it applies after restart."/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Default vendor" Style="{StaticResource FieldLabelTextStyle}"/>
                        <ComboBox x:Name="VendorComboBox" SelectionChanged="VendorComboBox_SelectionChanged" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Data folder" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="NetworkConfigDirTextBox" LostFocus="NetworkConfigDirTextBox_LostFocus"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Appearance ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Theme" Style="{StaticResource FieldLabelTextStyle}"/>
                        <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
