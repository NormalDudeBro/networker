<Page
    x:Class="networker.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:networker">

    <Grid Padding="20" RowDefinitions="Auto, Auto, *">
        <TextBox Grid.Row="0" x:Name="myTextBox" PlaceholderText="Enter your prompt here..." Height="100" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="15" Margin="0,0,0,10">
            <Button x:Name="RunButton" Content="Run AI" Click="RunButton_Click" Width="120" Style="{StaticResource AccentButtonStyle}"/>
            <ProgressRing x:Name="LoadingRing" IsActive="False" Visibility="Collapsed" Width="30" Height="30"/>
            <TextBlock x:Name="WarningText" Foreground="OrangeRed" VerticalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock x:Name="outputTextBlock" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="Awaiting prompt..."/>
        </ScrollViewer>
    </Grid>
</Page>