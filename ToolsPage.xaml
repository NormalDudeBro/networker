<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="networker.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:networker.Controls">

    <Grid Padding="20,16,20,12" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Network Toolkit" Style="{StaticResource SectionHeaderTextStyle}"/>
            <TextBlock Style="{StaticResource CaptionTextStyle}"
                       Text="Deterministic tools that run locally: IP math, config generation and audit, diffs, log analysis, playbooks, topology diagrams, and vendor translation."/>
        </StackPanel>

        <TabView x:Name="ToolsTabs" Grid.Row="1" Margin="0,14,0,0" IsAddTabButtonVisible="False" VerticalAlignment="Stretch">
            <TabView.TabItems>

                <!-- ===================== IP Calculator ===================== -->
                <TabViewItem Header="IP Calculator">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,12" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="CIDR" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="IpInput" PlaceholderText="e.g. 192.168.10.0/24 or 2001:db8::/64" Width="360"/>
                                    <Button Content="Calculate" Click="IpCalculate_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <controls:CodeBlockView x:Name="IpResult" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ===================== Config Generator ===================== -->
                <TabViewItem Header="Config Generator">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,12" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Platform" FontWeight="SemiBold"/>
                                <ComboBox x:Name="GeneratorPlatform" Width="280" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Cisco IOS-XE"/>
                                    <ComboBoxItem Content="Juniper Junos"/>
                                    <ComboBoxItem Content="Arista EOS"/>
                                    <ComboBoxItem Content="VyOS"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Device specification (JSON)" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Text="Describe the device as a JSON DeviceSpec: hostname, vlans, interfaces, ospf, bgp, acls, nat. A minimal spec is prefilled."/>
                                <TextBox x:Name="GeneratorSpec" AcceptsReturn="True" TextWrapping="NoWrap" Height="260"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{ThemeResource CodeFontFamily}"/>
                            </StackPanel>
                            <Button Content="Generate Configuration" Click="GeneratorGenerate_Click" HorizontalAlignment="Left"/>
                            <controls:CodeBlockView x:Name="GeneratorResult" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ===================== Config Audit ===================== -->
                <TabViewItem Header="Config Audit">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,12" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Configuration" FontWeight="SemiBold"/>
                                <TextBox x:Name="AuditInput" AcceptsReturn="True" TextWrapping="NoWrap" Height="240"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{ThemeResource CodeFontFamily}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Audit Configuration" Click="AuditRun_Click"/>
                                <Button x:Name="AuditAiButton" Content="Analyze with AI" Click="AuditAi_Click" Style="{StaticResource ChipButtonStyle}"/>
                            </StackPanel>
                            <ListView x:Name="AuditFindings" Visibility="Collapsed">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="44,110,180,*" ColumnSpacing="10" Padding="4,4">
                                            <TextBlock Text="{Binding Line}" Style="{StaticResource MonoTextStyle}" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                                            <Border Grid.Column="1" Padding="8,1" Background="{Binding SeverityBrush}" CornerRadius="10">
                                                <TextBlock Text="{Binding Severity}" Style="{StaticResource BadgeTextStyle}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding RuleId}" Style="{StaticResource MonoTextStyle}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Description}" Style="{StaticResource CaptionTextStyle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <controls:CodeBlockView x:Name="AuditAiResult" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ===================== Diff ===================== -->
                <TabViewItem Header="Config Diff">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,12" Spacing="12" MaxWidth="860" HorizontalAlignment="Left">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Baseline configuration" FontWeight="SemiBold"/>
                                    <TextBox x:Name="DiffOldInput" AcceptsReturn="True" TextWrapping="NoWrap" Height="220"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{ThemeResource CodeFontFamily}"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Grid.Column="1">
                                    <TextBlock Text="Candidate configuration" FontWeight="SemiBold"/>
                                    <TextBox x:Name="DiffNewInput" AcceptsReturn="True" TextWrapping="NoWrap" Height="220"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{ThemeResource CodeFontFamily}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Compare" Click="DiffRun_Click"/>
                                <Button x:Name="DiffAiButton" Content="Explain with AI" Click="DiffAi_Click" Style="{StaticResource ChipButtonStyle}"/>
                            </StackPanel>
                            <controls:CodeBlockView x:Name="DiffResult" Visibility="Collapsed"/>
                            <controls:CodeBlockView x:Name="DiffAiResult" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ===================== Log Analyzer ===================== -->
                <TabViewItem Header="Log Analyzer">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,12" Spacing="12" MaxWidth="860" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Syslog lines" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Text="Accepts RFC 3164, RFC 5424, or bare lines. Anomalies such as BGP flaps, auth failures, and CRC errors are flagged with severity."/>
                                <TextBox x:Name="LogInput" AcceptsReturn="True" TextWrapping="NoWrap" Height="220"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{ThemeResource CodeFontFamily}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Analyze Logs" Click="LogAnalyze_Click"/>
                                <Button x:Name="LogAiButton" Content="Analyze with AI" Click="LogAi_Click" Style="{StaticResource ChipButtonStyle}"/>
                            </StackPanel>
                            <ListView x:Name="LogFindings" Visibility="Collapsed">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="44,110,160,*" ColumnSpacing="10" Padding="4,4">
                                            <TextBlock Text="{Binding Line}" Style="{StaticResource MonoTextStyle}" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                                            <Border Grid.Column="1" Padding="8,1" Background="{Binding SeverityBrush}" CornerRadius="10">
                                                <TextBlock Text="{Binding Severity}" Style="{StaticResource BadgeTextStyle}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding RuleId}" Style="{StaticResource MonoTextStyle}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Description}" Style="{StaticResource CaptionTextStyle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <controls:CodeBlockView x:Name="LogAiResult" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ===================== Playbooks ===================== -->
                <TabViewItem Header="Playbooks">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,12" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Scenario" FontWeight="SemiBold"/>
                                <ComboBox x:Name="PlaybookScenario" Width="280" HorizontalAlignment="Left" SelectionChanged="PlaybookScenario_SelectionChanged">
                                    <ComboBoxItem Content="New switch (day-0)"/>
                                    <ComboBoxItem Content="BGP session flapping"/>
                                    <ComboBoxItem Content="High CPU"/>
                                    <ComboBoxItem Content="Interface down"/>
                                    <ComboBoxItem Content="OSPF adjacency"/>
                                    <ComboBoxItem Content="Security hardening"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Generate Playbook" Click="PlaybookGenerate_Click"/>
                                <Button x:Name="PlaybookAiButton" Content="Generate with AI" Click="PlaybookAi_Click" Style="{StaticResource ChipButtonStyle}"/>
                            </StackPanel>
                            <controls:CodeBlockView x:Name="PlaybookResult" Visibility="Collapsed"/>
                            <controls:CodeBlockView x:Name="PlaybookAiResult" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ===================== Topology ===================== -->
                <TabViewItem Header="Topology">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,12" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Device configs" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Text="Paste one or more device configurations separated by the marker line '==== device-name ===='. Links are inferred from shared /30-/31 subnets, BGP neighbors, and static-route next hops."/>
                                <TextBox x:Name="TopologyInput" AcceptsReturn="True" TextWrapping="NoWrap" Height="260"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{ThemeResource CodeFontFamily}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Build Topology" Click="TopologyBuild_Click"/>
                                <Button x:Name="TopologyAiButton" Content="Describe with AI" Click="TopologyAi_Click" Style="{StaticResource ChipButtonStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="TopologySummary" Style="{StaticResource CaptionTextStyle}" Visibility="Collapsed"/>
                            <controls:CodeBlockView x:Name="TopologyResult" Visibility="Collapsed"/>
                            <controls:CodeBlockView x:Name="TopologyAiResult" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ===================== Translator ===================== -->
                <TabViewItem Header="Translator">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,12" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Direction" FontWeight="SemiBold"/>
                                <ComboBox x:Name="TranslateDirection" Width="280" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Cisco IOS-XE to Juniper Junos"/>
                                    <ComboBoxItem Content="Juniper Junos to Cisco IOS-XE"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Configuration" FontWeight="SemiBold"/>
                                <TextBox x:Name="TranslateInput" AcceptsReturn="True" TextWrapping="NoWrap" Height="240"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{ThemeResource CodeFontFamily}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Translate" Click="TranslateRun_Click"/>
                                <Button x:Name="TranslateAiButton" Content="Translate with AI" Click="TranslateAi_Click" Style="{StaticResource ChipButtonStyle}"/>
                            </StackPanel>
                            <controls:CodeBlockView x:Name="TranslateResult" Visibility="Collapsed"/>
                            <controls:CodeBlockView x:Name="TranslateAiResult" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

            </TabView.TabItems>
        </TabView>
    </Grid>
</Page>
