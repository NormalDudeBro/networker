<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="networker.NetworkConfig.Views.Tabs.GenerateTab"
    x:Name="GenerateRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:networker.NetworkConfig.Views.Tabs"
    xmlns:services="using:Networker.Core.Services.NetworkConfig"
    xmlns:controls="using:networker.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,12" Spacing="14" MaxWidth="880" HorizontalAlignment="Left">

            <!-- ===================== Template ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Template" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="TemplateSelector" Width="320" MinWidth="260" DisplayMemberPath="Name"/>
                        <Button Content="Apply Template" Click="ApplyTemplate_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="Select a predefined template to pre-fill the form (vendor, interfaces, VLANs, routing, ACLs). Adjust any value, then generate."/>
                </StackPanel>
            </Border>

            <!-- ===================== Device Basics ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Device Basics" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Vendor" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <ComboBox x:Name="VendorSelector" Grid.Row="0" Grid.Column="1" Width="260" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Hostname" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="HostnameInput" Grid.Row="1" Grid.Column="1" PlaceholderText="e.g. core-router-01"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Domain Name" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="DomainInput" Grid.Row="2" Grid.Column="1" PlaceholderText="e.g. example.com"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Enable Secret" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <PasswordBox x:Name="EnableInput" Grid.Row="3" Grid.Column="1" PlaceholderText="Optional privileged EXEC secret"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="DNS Servers" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="DnsInput" Grid.Row="4" Grid.Column="1" PlaceholderText="Comma-separated, e.g. 8.8.8.8, 8.8.4.4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="NTP Servers" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="NtpInput" Grid.Row="5" Grid.Column="1" PlaceholderText="Comma-separated, e.g. pool.ntp.org"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== Interfaces ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Interfaces" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <ItemsControl x:Name="InterfaceRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:TemplateInterfaceEntry">
                                <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" MinWidth="160"
                                              ItemsSource="{x:Bind local:GenerateTab.InterfaceTypeOptions}"
                                              SelectedItem="{x:Bind Type, Mode=TwoWay}"/>
                                    <TextBox Grid.Column="1" Text="{x:Bind Number, Mode=TwoWay}" PlaceholderText="Number"/>
                                    <TextBox Grid.Column="2" Text="{x:Bind Description, Mode=TwoWay}" PlaceholderText="Description"/>
                                    <TextBox Grid.Column="3" Text="{x:Bind Ip, Mode=TwoWay}" PlaceholderText="IP address"/>
                                    <TextBox Grid.Column="4" Text="{x:Bind Mask, Mode=TwoWay}" PlaceholderText="Subnet mask"/>
                                    <Button Grid.Column="5" Content="Remove" Click="RemoveInterface_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add Interface" Click="AddInterface_Click" HorizontalAlignment="Left" Style="{StaticResource ChipButtonStyle}"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="Interface names are derived from the type and vendor automatically (e.g. GigabitEthernet0/0, ge-0/0/0, Ethernet1). Rows without a number are ignored."/>
                </StackPanel>
            </Border>

            <!-- ===================== VLANs & Static Routes ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="VLANs &amp; Static Routes" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="VLANs — one per line: vlan_id,name" Style="{StaticResource FieldLabelTextStyle}"/>
                    <TextBox x:Name="VlansInput" AcceptsReturn="True" TextWrapping="Wrap" Height="88"
                             PlaceholderText="10,MANAGEMENT&#x0a;20,DATA&#x0a;30,VOICE"/>
                    <TextBlock Text="Static Routes — one per line: destination,mask,next-hop" Style="{StaticResource FieldLabelTextStyle}"/>
                    <TextBox x:Name="RoutesInput" AcceptsReturn="True" TextWrapping="Wrap" Height="88"
                             PlaceholderText="0.0.0.0,0.0.0.0,10.0.0.1"/>
                </StackPanel>
            </Border>

            <!-- ===================== ACL ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Access Control List" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ACL Name" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="AclNameInput" Grid.Column="1" PlaceholderText="e.g. INBOUND-FILTER"/>
                        <TextBlock Grid.Column="2" Text="Type" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <ComboBox x:Name="AclTypeCombo" Grid.Column="3" ItemsSource="{x:Bind local:GenerateTab.AclTypeOptions}" SelectedIndex="1"/>
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="The ACL is included only when a name is set and at least one entry has a sequence and source."/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AclEntryRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:TemplateAclEntry">
                                    <Grid ColumnSpacing="6" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{x:Bind Sequence, Mode=TwoWay}" PlaceholderText="Seq"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind local:GenerateTab.AclActionOptions}"
                                                  SelectedItem="{x:Bind Action, Mode=TwoWay}"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{x:Bind local:GenerateTab.AclProtocolOptions}"
                                                  SelectedItem="{x:Bind Protocol, Mode=TwoWay}"/>
                                        <TextBox Grid.Column="3" Text="{x:Bind Source, Mode=TwoWay}" PlaceholderText="Source"/>
                                        <TextBox Grid.Column="4" Text="{x:Bind SourceWildcard, Mode=TwoWay}" PlaceholderText="Src wildcard"/>
                                        <TextBox Grid.Column="5" Text="{x:Bind Destination, Mode=TwoWay}" PlaceholderText="Destination"/>
                                        <TextBox Grid.Column="6" Text="{x:Bind DestinationWildcard, Mode=TwoWay}" PlaceholderText="Dst wildcard"/>
                                        <TextBox Grid.Column="7" Text="{x:Bind DestinationPort, Mode=TwoWay}" PlaceholderText="Dst port"/>
                                        <ComboBox Grid.Column="8" ItemsSource="{x:Bind local:GenerateTab.LogOptions}"
                                                  SelectedItem="{x:Bind Log, Mode=TwoWay}"/>
                                        <Button Grid.Column="9" Content="Remove" Click="RemoveAclEntry_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Content="Add Entry" Click="AddAclEntry_Click" HorizontalAlignment="Left" Style="{StaticResource ChipButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- ===================== OSPF ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="OSPF" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Process ID" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="OspfProcessInput" Grid.Column="1" PlaceholderText="e.g. 1"/>
                        <TextBlock Grid.Column="2" Text="Router ID" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="OspfRouterIdInput" Grid.Column="3" PlaceholderText="Optional"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ref. Bandwidth" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="OspfRefBwInput" Grid.Row="1" Grid.Column="1" PlaceholderText="Default 100"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Passive Interfaces" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="OspfPassiveInput" Grid.Row="1" Grid.Column="3" PlaceholderText="Comma-separated"/>
                    </Grid>
                    <TextBlock Text="Networks — one per line: network,wildcard,area" Style="{StaticResource FieldLabelTextStyle}"/>
                    <TextBox x:Name="OspfNetworksInput" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                             PlaceholderText="10.0.0.0,0.0.0.255,0"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="OSPF is included only when a process ID is set."/>
                </StackPanel>
            </Border>

            <!-- ===================== BGP ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="BGP" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Local AS" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="BgpAsInput" Grid.Column="1" PlaceholderText="e.g. 65000"/>
                        <TextBlock Grid.Column="2" Text="Router ID" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="BgpRouterIdInput" Grid.Column="3" PlaceholderText="Optional"/>
                    </Grid>
                    <ItemsControl x:Name="BgpNeighborRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:TemplateBgpNeighbor">
                                <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{x:Bind IpAddress, Mode=TwoWay}" PlaceholderText="Neighbor IP"/>
                                    <TextBox Grid.Column="1" Text="{x:Bind RemoteAs, Mode=TwoWay}" PlaceholderText="Remote AS"/>
                                    <TextBox Grid.Column="2" Text="{x:Bind Description, Mode=TwoWay}" PlaceholderText="Description"/>
                                    <TextBox Grid.Column="3" Text="{x:Bind UpdateSource, Mode=TwoWay}" PlaceholderText="Update source"/>
                                    <TextBox Grid.Column="4" Text="{x:Bind EbgpMultihop, Mode=TwoWay}" PlaceholderText="Multihop"/>
                                    <Button Grid.Column="5" Content="Remove" Click="RemoveBgpNeighbor_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add Neighbor" Click="AddBgpNeighbor_Click" HorizontalAlignment="Left" Style="{StaticResource ChipButtonStyle}"/>
                    <TextBlock Text="Networks — one per line" Style="{StaticResource FieldLabelTextStyle}"/>
                    <TextBox x:Name="BgpNetworksInput" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                             PlaceholderText="10.0.0.0/8"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="BGP is included only when a local AS is set. Neighbor rows need both an IP and a remote AS."/>
                </StackPanel>
            </Border>

            <!-- ===================== EIGRP ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="EIGRP" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="AS Number" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="EigrpAsInput" Grid.Column="1" PlaceholderText="e.g. 100"/>
                        <TextBlock Grid.Column="2" Text="Router ID" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="EigrpRouterIdInput" Grid.Column="3" PlaceholderText="Optional"/>
                        <CheckBox x:Name="EigrpNamedModeCheck" Grid.Row="1" Grid.Column="0" Content="Named Mode"/>
                        <TextBox x:Name="EigrpNameInput" Grid.Row="1" Grid.Column="1" PlaceholderText="Process name (default EIGRP_PROCESS)"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Passive Interfaces" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="EigrpPassiveInput" Grid.Row="1" Grid.Column="3" PlaceholderText="Comma-separated"/>
                    </Grid>
                    <TextBlock Text="Networks — one per line: network[,wildcard]" Style="{StaticResource FieldLabelTextStyle}"/>
                    <TextBox x:Name="EigrpNetworksInput" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                             PlaceholderText="10.0.0.0,0.0.0.255"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="EIGRP is included only when an AS number is set."/>
                </StackPanel>
            </Border>

            <!-- ===================== STP ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Spanning Tree Protocol" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mode" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <ComboBox x:Name="StpModeCombo" Grid.Column="1" ItemsSource="{x:Bind local:GenerateTab.StpModeOptions}" SelectedIndex="0"/>
                        <TextBlock Grid.Column="2" Text="Priority" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="StpPriorityInput" Grid.Column="3" PlaceholderText="e.g. 4096"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Root Primary VLANs" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="StpRootPrimaryInput" Grid.Row="1" Grid.Column="1" PlaceholderText="Comma-separated"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Root Secondary VLANs" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="StpRootSecondaryInput" Grid.Row="1" Grid.Column="3" PlaceholderText="Comma-separated"/>
                        <CheckBox x:Name="StpPortfastCheck" Grid.Row="2" Grid.Column="0" Content="Portfast Default" VerticalAlignment="Center"/>
                        <CheckBox x:Name="StpBpduguardCheck" Grid.Row="2" Grid.Column="2" Content="BPDU Guard Default" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="STP is included only when at least one option is configured."/>
                </StackPanel>
            </Border>

            <!-- ===================== Output ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Output" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Generate Configuration" Style="{StaticResource PrimaryButtonStyle}" Click="Generate_Click">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" Modifiers="Control" ScopeOwner="{x:Bind GenerateRoot}"/>
                            </Button.KeyboardAccelerators>
                        </Button>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                    <controls:CodeBlockView x:Name="GenerateOutput" Visibility="Collapsed"/>
                    <TextBlock x:Name="ValidationSummaryText" Style="{StaticResource FieldLabelTextStyle}" Visibility="Collapsed"/>
                    <ListView x:Name="ValidationList" Visibility="Collapsed" SelectionMode="None" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="{ThemeResource RadiusPill}" Padding="10,2" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Grid>
                                            <Border Background="{Binding SeverityBrush}" Opacity="0.16" CornerRadius="{ThemeResource RadiusPill}"/>
                                            <TextBlock Text="{Binding Severity}" Style="{StaticResource BadgeTextStyle}" FontWeight="SemiBold"
                                                       Foreground="{Binding SeverityBrush}" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource MonoTextStyle}" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Recommendation}" Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
