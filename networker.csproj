<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>networker</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Networker.Core\Networker.Core.csproj" />
    <ProjectReference Include="Networker.Update.Contracts\Networker.Update.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Networker.Core\**" />
    <Compile Remove="Networker.Core.Tests\**" />
    <Compile Remove="Networker.Update.Contracts\**" />
    <Compile Remove="Networker.Update\**" />
    <Compile Remove="Networker.Update.Tests\**" />
    <Compile Remove="Networker.Launcher\**" />
    <Compile Remove="Networker.Bootstrap\**" />
    <Compile Remove="Networker.UpdateHost\**" />
    <Content Remove="Networker.Core\**" />
    <Content Remove="Networker.Core.Tests\**" />
    <Content Remove="Networker.Update.Contracts\**" />
    <Content Remove="Networker.Update\**" />
    <Content Remove="Networker.Update.Tests\**" />
    <Content Remove="Networker.Launcher\**" />
    <Content Remove="Networker.Bootstrap\**" />
    <Content Remove="Networker.UpdateHost\**" />
    <None Remove="Networker.Core\**" />
    <None Remove="Networker.Core.Tests\**" />
    <None Remove="Networker.Update.Contracts\**" />
    <None Remove="Networker.Update\**" />
    <None Remove="Networker.Update.Tests\**" />
    <None Remove="Networker.Launcher\**" />
    <None Remove="Networker.Bootstrap\**" />
    <None Remove="Networker.UpdateHost\**" />
    <Page Remove="Networker.Core\**" />
    <Page Remove="Networker.Core.Tests\**" />
    <Page Remove="Networker.Update.Contracts\**" />
    <Page Remove="Networker.Update\**" />
    <Page Remove="Networker.Update.Tests\**" />
    <Page Remove="Networker.Launcher\**" />
    <Page Remove="Networker.Bootstrap\**" />
    <Page Remove="Networker.UpdateHost\**" />
    <Resource Remove="Networker.Core\**" />
    <Resource Remove="Networker.Core.Tests\**" />
    <Resource Remove="Networker.Update.Contracts\**" />
    <Resource Remove="Networker.Update\**" />
    <Resource Remove="Networker.Update.Tests\**" />
    <Resource Remove="Networker.Launcher\**" />
    <Resource Remove="Networker.Bootstrap\**" />
    <Resource Remove="Networker.UpdateHost\**" />
  </ItemGroup>

  <!-- Single-project MSIX Packaging Capability -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <!-- Keep restore/build/publish inputs identical across local and clean CI environments. -->
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <!-- WinUI/WinRT activation relies on metadata the .NET trimmer cannot safely infer. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <!--
    Release packaging for the production x64 MSIX channel. Local Release builds
    stay unsigned (the release workflow signs with the trusted certificate);
    the workflow overrides AppxPackageSigningEnabled and passes the PFX.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>
</Project>
