<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="networker.NetworkConfig.Views.Tabs.VaultTab"
    x:Name="VaultRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:networker.Controls"
    xmlns:local="using:networker.NetworkConfig.Views.Tabs">

    <Grid x:Name="VaultLayout">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VaultWidthStates">
                <VisualState x:Name="NarrowVault">
                    <VisualState.StateTriggers>
                        <controls:ElementWidthTrigger Source="{x:Bind VaultLayout}" MaxWidth="819.999"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VaultVariableColumn.Width" Value="0*"/>
                        <Setter Target="VariablesPanel.(Grid.Row)" Value="1"/>
                        <Setter Target="VariablesPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="VariablesPanel.(Grid.ColumnSpan)" Value="2"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideVault">
                    <VisualState.StateTriggers>
                        <controls:ElementWidthTrigger Source="{x:Bind VaultLayout}" MinWidth="820"/>
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer Style="{StaticResource WorkflowScrollViewerStyle}">
            <StackPanel Style="{StaticResource DenseTabContentStackStyle}">
                <Border Style="{StaticResource ToolInputPanelStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="ENCRYPTED VAULT" Style="{StaticResource SectionLabelTextStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="VaultStatusDot" Style="{StaticResource StatusDotStyle}" Fill="{ThemeResource AppTextDisabledBrush}" AutomationProperties.Name="Vault status"/>
                                    <TextBlock x:Name="VaultStatusText" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="VaultLockButton" Grid.Column="1" Content="Lock" Click="Lock_Click" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <PasswordBox x:Name="VaultPasswordInput" PlaceholderText="Master password" AutomationProperties.Name="Vault master password"/>
                            <Button x:Name="VaultUnlockButton" Grid.Column="1" Content="Unlock" Style="{StaticResource PrimaryButtonStyle}" Click="UnlockOrCreate_Click"/>
                        </Grid>
                        <TextBlock x:Name="StatusText" Style="{StaticResource InlineStatusTextStyle}" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="Stored data is encrypted with AES-256-GCM and a PBKDF2-SHA256 key. Credential passwords and secret variable values are never displayed." Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="VaultLockedState" Style="{StaticResource EmptyStatePanelStyle}" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Stored data is unavailable" FontWeight="SemiBold"/>
                            <TextBlock Text="Create or unlock the vault to manage credentials and template variables." Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="VaultDataPanel" Visibility="Collapsed" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="VaultVariableColumn" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource ToolInputPanelStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="STORED CREDENTIALS" Style="{StaticResource SectionLabelTextStyle}"/>
                                <TextBlock Text="Passwords remain encrypted and are never shown in this list." Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>
                            <Border x:Name="CredentialEmptyState" Style="{StaticResource InsetPanelStyle}">
                                <TextBlock Text="No credentials stored." Style="{StaticResource CaptionTextStyle}"/>
                            </Border>
                            <ListView x:Name="CredentialList" SelectionMode="None" MinHeight="100">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:VaultCredentialRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,5">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Style="{StaticResource MonoSecondaryTextStyle}" Text="{x:Bind Username}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="DeleteCredentialRow_Click" ToolTipService.ToolTip="Delete credential" AutomationProperties.Name="Delete stored credential">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource AppDangerBrush}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Border Style="{StaticResource InsetPanelStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Add credential" Style="{StaticResource CardTitleTextStyle}"/>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <TextBox x:Name="CredNameInput" PlaceholderText="Name" AutomationProperties.Name="Credential name"/>
                                        <TextBox x:Name="CredUserInput" Grid.Column="1" PlaceholderText="Username" AutomationProperties.Name="Credential username"/>
                                        <PasswordBox x:Name="CredPassInput" Grid.Row="1" PlaceholderText="Password" AutomationProperties.Name="Credential password"/>
                                        <TextBox x:Name="CredDescInput" Grid.Row="1" Grid.Column="1" PlaceholderText="Description" AutomationProperties.Name="Credential description"/>
                                    </Grid>
                                    <Button x:Name="AddCredentialButton" Content="Add credential" Style="{StaticResource PrimaryButtonStyle}" Click="AddCredential_Click" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="VariablesPanel" Grid.Column="1" Style="{StaticResource ToolInputPanelStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="TEMPLATE VARIABLES" Style="{StaticResource SectionLabelTextStyle}"/>
                                <TextBlock Text="Secret values are masked; normal values remain visible for verification." Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>
                            <Border x:Name="VariableEmptyState" Style="{StaticResource InsetPanelStyle}">
                                <TextBlock Text="No variables stored." Style="{StaticResource CaptionTextStyle}"/>
                            </Border>
                            <ListView x:Name="VariableList" SelectionMode="None" MinHeight="100">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:VaultVariableRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,5">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <Border Style="{StaticResource BadgeInfoStyle}" Padding="7,1">
                                                        <TextBlock Text="{x:Bind Classification}" Style="{StaticResource BadgeTextStyle}" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind DisplayValue}" Style="{StaticResource MonoSecondaryTextStyle}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="DeleteVariableRow_Click" ToolTipService.ToolTip="Delete variable" AutomationProperties.Name="Delete stored variable">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource AppDangerBrush}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Border Style="{StaticResource InsetPanelStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Add variable" Style="{StaticResource CardTitleTextStyle}"/>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <TextBox x:Name="VarNameInput" PlaceholderText="Variable name" AutomationProperties.Name="Variable name"/>
                                        <TextBox x:Name="VarValueInput" Grid.Column="1" PlaceholderText="Value" AutomationProperties.Name="Variable value"/>
                                        <ComboBox x:Name="VarSecretCombo" Grid.Row="1" SelectedIndex="0" AutomationProperties.Name="Variable classification">
                                            <x:String>Normal</x:String>
                                            <x:String>Secret</x:String>
                                        </ComboBox>
                                        <Button x:Name="AddVariableButton" Grid.Row="1" Grid.Column="1" Content="Add variable" Style="{StaticResource PrimaryButtonStyle}" Click="AddVariable_Click" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
