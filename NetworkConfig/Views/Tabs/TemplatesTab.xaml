<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="networker.NetworkConfig.Views.Tabs.TemplatesTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:networker.NetworkConfig.Views.Tabs"
    xmlns:controls="using:networker.Controls">

    <Grid Padding="16,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="Templates" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="Predefined device templates plus any custom templates you save. Select one to preview the generated configuration."/>
                <ListView x:Name="TemplateList" SelectionChanged="TemplateList_SelectionChanged" MinHeight="420">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TemplateListItem">
                            <StackPanel Spacing="3" Padding="0,4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                    <Border Style="{StaticResource BadgeInfoStyle}" Padding="8,1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind BadgeText}" Style="{StaticResource BadgeTextStyle}" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="10">
                <TextBlock x:Name="DetailTitle" Text="No template selected" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock x:Name="DetailMeta" Style="{StaticResource CaptionTextStyle}"/>
                <controls:CodeBlockView x:Name="DetailPreview" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="DeleteButton" Content="Delete Custom Template" Click="Delete_Click"
                            Style="{StaticResource DangerButtonStyle}" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
