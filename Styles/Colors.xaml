<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Design tokens — the single source of color truth for the app.
        Semantic naming: tokens describe MEANING (success, warning, online,
        selected) not surface decoration. Color is used for meaning only.
        Every key below is consumed via {ThemeResource ...} so Light/Dark
        switch automatically with the app theme.
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">

            <!-- Surfaces -->
            <Color x:Key="AppBackgroundColor">#F4F7F9</Color>
            <Color x:Key="AppShellColor">#EAF0F3</Color>
            <Color x:Key="AppSurfaceColor">#FFFFFF</Color>
            <Color x:Key="AppSurfaceAltColor">#EDF3F5</Color>
            <Color x:Key="AppInsetColor">#F0F4F6</Color>
            <Color x:Key="AppCardColor">#FFFFFF</Color>
            <Color x:Key="AppCodeBackgroundColor">#F2F6F8</Color>
            <Color x:Key="AppScrimColor">#66000000</Color>

            <!-- Interaction states -->
            <Color x:Key="AppAccentMutedColor">#D8EEF3</Color>

            <!-- Text -->
            <Color x:Key="AppTextPrimaryColor">#18242C</Color>
            <Color x:Key="AppTextSecondaryColor">#52616B</Color>
            <Color x:Key="AppTextDisabledColor">#82919A</Color>

            <!-- Lines -->
            <Color x:Key="AppBorderColor">#CBD7DD</Color>

            <!-- Semantic / status -->
            <Color x:Key="AppAccentColor">#0A7188</Color>
            <Color x:Key="AppAccentPressedColor">#064D5D</Color>
            <Color x:Key="AppInfoColor">#0A7188</Color>
            <Color x:Key="AppSuccessColor">#1A7F37</Color>
            <Color x:Key="AppWarningColor">#9A6700</Color>
            <Color x:Key="AppDangerColor">#CF222E</Color>
            <Color x:Key="AppOnlineColor">#1A7F37</Color>
            <Color x:Key="AppOfflineColor">#59636E</Color>

            <!-- Chat -->
            <Color x:Key="AppChatUserBubbleColor">#D8EEF3</Color>
            <Color x:Key="AppChatUserTextColor">#18242C</Color>

            <!-- Text on accent backgrounds (primary buttons, user bubbles) -->
            <Color x:Key="AppOnAccentColor">#FFFFFF</Color>
            <Color x:Key="AppOnDangerColor">#FFFFFF</Color>

            <!-- Syntax (code highlighting) -->
            <Color x:Key="AppKeywordColor">#075F73</Color>
            <Color x:Key="AppIpColor">#116329</Color>
            <Color x:Key="AppCommentColor">#6E7781</Color>
            <Color x:Key="AppNumberColor">#9A6700</Color>

            <!-- Badge fills -->
            <Color x:Key="BadgeInfoBackgroundColor">#D8EEF3</Color>
            <Color x:Key="BadgeSuccessBackgroundColor">#DDF4E4</Color>
            <Color x:Key="BadgeWarningBackgroundColor">#FFF2D5</Color>
            <Color x:Key="BadgeDangerBackgroundColor">#FFE3E2</Color>

            <!-- Terminal (always a dark surface, same in both themes) -->
            <Color x:Key="TerminalBackgroundColor">#0B1218</Color>
            <Color x:Key="TerminalHeaderColor">#131E28</Color>
            <Color x:Key="TerminalTextColor">#D9E2EA</Color>
            <Color x:Key="TerminalPromptColor">#58BBD2</Color>
            <Color x:Key="TerminalCaptionColor">#8B949E</Color>

            <!-- Diff (translucent so they layer over either theme) -->
            <Color x:Key="DiffAddedBackgroundColor">#2A1A7F37</Color>
            <Color x:Key="DiffRemovedBackgroundColor">#2ACF222E</Color>
            <Color x:Key="DiffHeaderBackgroundColor">#1F0A7188</Color>

        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">

            <!-- Surfaces -->
            <Color x:Key="AppBackgroundColor">#091016</Color>
            <Color x:Key="AppShellColor">#0C141B</Color>
            <Color x:Key="AppSurfaceColor">#111A22</Color>
            <Color x:Key="AppSurfaceAltColor">#16222C</Color>
            <Color x:Key="AppInsetColor">#0B131A</Color>
            <Color x:Key="AppCardColor">#111A22</Color>
            <Color x:Key="AppCodeBackgroundColor">#070D12</Color>
            <Color x:Key="AppScrimColor">#8C000000</Color>

            <!-- Interaction states -->
            <Color x:Key="AppAccentMutedColor">#153440</Color>

            <!-- Text -->
            <Color x:Key="AppTextPrimaryColor">#E6EEF2</Color>
            <Color x:Key="AppTextSecondaryColor">#9DADB7</Color>
            <Color x:Key="AppTextDisabledColor">#667680</Color>

            <!-- Lines -->
            <Color x:Key="AppBorderColor">#263640</Color>

            <!-- Semantic / status -->
            <Color x:Key="AppAccentColor">#58BBD2</Color>
            <Color x:Key="AppAccentPressedColor">#3B9FB6</Color>
            <Color x:Key="AppInfoColor">#58BBD2</Color>
            <Color x:Key="AppSuccessColor">#3FB950</Color>
            <Color x:Key="AppWarningColor">#D29922</Color>
            <Color x:Key="AppDangerColor">#F85149</Color>
            <Color x:Key="AppOnlineColor">#3FB950</Color>
            <Color x:Key="AppOfflineColor">#8B949E</Color>

            <!-- Chat -->
            <Color x:Key="AppChatUserBubbleColor">#153440</Color>
            <Color x:Key="AppChatUserTextColor">#E6EEF2</Color>

            <!-- Text on accent backgrounds (primary buttons, user bubbles).
                 Dark theme keeps a bright accent, so the on-accent foreground
                 inverts to near-black to hold a 4.5:1 text contrast ratio. -->
            <Color x:Key="AppOnAccentColor">#061116</Color>
            <Color x:Key="AppOnDangerColor">#FFFFFF</Color>

            <!-- Syntax (code highlighting) -->
            <Color x:Key="AppKeywordColor">#7BD3E6</Color>
            <Color x:Key="AppIpColor">#3FB950</Color>
            <Color x:Key="AppCommentColor">#8B949E</Color>
            <Color x:Key="AppNumberColor">#D29922</Color>

            <!-- Badge fills -->
            <Color x:Key="BadgeInfoBackgroundColor">#153440</Color>
            <Color x:Key="BadgeSuccessBackgroundColor">#13271B</Color>
            <Color x:Key="BadgeWarningBackgroundColor">#2C2413</Color>
            <Color x:Key="BadgeDangerBackgroundColor">#2B1A1A</Color>

            <!-- Terminal (always a dark surface, same in both themes) -->
            <Color x:Key="TerminalBackgroundColor">#0B1218</Color>
            <Color x:Key="TerminalHeaderColor">#131E28</Color>
            <Color x:Key="TerminalTextColor">#D9E2EA</Color>
            <Color x:Key="TerminalPromptColor">#58BBD2</Color>
            <Color x:Key="TerminalCaptionColor">#8B949E</Color>

            <!-- Diff (translucent so they layer over either theme) -->
            <Color x:Key="DiffAddedBackgroundColor">#2A1A7F37</Color>
            <Color x:Key="DiffRemovedBackgroundColor">#2ACF222E</Color>
            <Color x:Key="DiffHeaderBackgroundColor">#1F0A7188</Color>

        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ===================== Surfaces ===================== -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppShellBrush" Color="{ThemeResource AppShellColor}" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{ThemeResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="{ThemeResource AppSurfaceAltColor}" />
    <SolidColorBrush x:Key="AppInsetBrush" Color="{ThemeResource AppInsetColor}" />
    <SolidColorBrush x:Key="AppCardBrush" Color="{ThemeResource AppCardColor}" />
    <SolidColorBrush x:Key="AppCodeBackgroundBrush" Color="{ThemeResource AppCodeBackgroundColor}" />
    <SolidColorBrush x:Key="AppScrimBrush" Color="{ThemeResource AppScrimColor}" />

    <!-- ===================== Interaction states ===================== -->
    <SolidColorBrush x:Key="AppAccentMutedBrush" Color="{ThemeResource AppAccentMutedColor}" />

    <!-- ===================== Text ===================== -->
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{ThemeResource AppTextPrimaryColor}" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{ThemeResource AppTextSecondaryColor}" />
    <SolidColorBrush x:Key="AppTextDisabledBrush" Color="{ThemeResource AppTextDisabledColor}" />

    <!-- ===================== Lines ===================== -->
    <SolidColorBrush x:Key="AppBorderBrush" Color="{ThemeResource AppBorderColor}" />

    <!-- ===================== Semantic / status ===================== -->
    <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppAccentPressedBrush" Color="{ThemeResource AppAccentPressedColor}" />
    <SolidColorBrush x:Key="AppInfoBrush" Color="{ThemeResource AppInfoColor}" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="{ThemeResource AppSuccessColor}" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="{ThemeResource AppWarningColor}" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="{ThemeResource AppDangerColor}" />
    <SolidColorBrush x:Key="AppOnlineBrush" Color="{ThemeResource AppOnlineColor}" />
    <SolidColorBrush x:Key="AppOfflineBrush" Color="{ThemeResource AppOfflineColor}" />

    <!-- ===================== Chat ===================== -->
    <SolidColorBrush x:Key="AppChatUserBubbleBrush" Color="{ThemeResource AppChatUserBubbleColor}" />
    <SolidColorBrush x:Key="AppChatUserTextBrush" Color="{ThemeResource AppChatUserTextColor}" />

    <!-- ===================== Text on accent ===================== -->
    <SolidColorBrush x:Key="AppOnAccentBrush" Color="{ThemeResource AppOnAccentColor}" />
    <SolidColorBrush x:Key="AppOnDangerBrush" Color="{ThemeResource AppOnDangerColor}" />

    <!-- ===================== Syntax ===================== -->
    <SolidColorBrush x:Key="AppKeywordBrush" Color="{ThemeResource AppKeywordColor}" />
    <SolidColorBrush x:Key="AppIpBrush" Color="{ThemeResource AppIpColor}" />
    <SolidColorBrush x:Key="AppCommentBrush" Color="{ThemeResource AppCommentColor}" />
    <SolidColorBrush x:Key="AppNumberBrush" Color="{ThemeResource AppNumberColor}" />

    <!-- ===================== Badges ===================== -->
    <SolidColorBrush x:Key="BadgeInfoBackgroundBrush" Color="{ThemeResource BadgeInfoBackgroundColor}" />
    <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="{ThemeResource BadgeSuccessBackgroundColor}" />
    <SolidColorBrush x:Key="BadgeWarningBackgroundBrush" Color="{ThemeResource BadgeWarningBackgroundColor}" />
    <SolidColorBrush x:Key="BadgeDangerBackgroundBrush" Color="{ThemeResource BadgeDangerBackgroundColor}" />

    <!-- ===================== Terminal ===================== -->
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="{ThemeResource TerminalBackgroundColor}" />
    <SolidColorBrush x:Key="TerminalHeaderBrush" Color="{ThemeResource TerminalHeaderColor}" />
    <SolidColorBrush x:Key="TerminalTextBrush" Color="{ThemeResource TerminalTextColor}" />
    <SolidColorBrush x:Key="TerminalPromptBrush" Color="{ThemeResource TerminalPromptColor}" />
    <SolidColorBrush x:Key="TerminalCaptionBrush" Color="{ThemeResource TerminalCaptionColor}" />

    <!-- ===================== Diff ===================== -->
    <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="{ThemeResource DiffAddedBackgroundColor}" />
    <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="{ThemeResource DiffRemovedBackgroundColor}" />
    <SolidColorBrush x:Key="DiffHeaderBackgroundBrush" Color="{ThemeResource DiffHeaderBackgroundColor}" />

</ResourceDictionary>
