<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="networker.Controls.TerminalPane"
    x:Name="TerminalPaneRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Height="260"
        Background="{StaticResource TerminalBackgroundBrush}"
        BorderBrush="{StaticResource TerminalHeaderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <Border
                Grid.Row="0"
                Background="{StaticResource TerminalHeaderBrush}"
                CornerRadius="8,8,0,0"
                Padding="12,8">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                    <FontIcon
                        Glyph="&#xE756;"
                        FontSize="13"
                        Foreground="{StaticResource TerminalPromptBrush}"
                        VerticalAlignment="Center"/>
                    <TextBlock
                        Grid.Column="1"
                        Text="Terminal"
                        Foreground="{StaticResource TerminalTextBrush}"
                        FontFamily="{StaticResource CodeFontFamily}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>
                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind SessionStatus, Mode=OneWay}"
                        Foreground="{StaticResource TerminalCaptionBrush}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"/>
                    <ProgressRing
                        Grid.Column="3"
                        Width="12"
                        Height="12"
                        IsActive="True"
                        IsIndeterminate="True"
                        Visibility="{x:Bind SessionRunningVisibility, Mode=OneWay}"
                        Foreground="{StaticResource TerminalPromptBrush}"
                        VerticalAlignment="Center"/>
                    <Button
                        Grid.Column="4"
                        Style="{StaticResource IconButtonStyle}"
                        Click="RestartButton_Click"
                        ToolTipService.ToolTip="Restart session"
                        AutomationProperties.Name="Restart terminal session">
                        <FontIcon Glyph="&#xE777;" FontSize="13"/>
                    </Button>
                    <Button
                        Grid.Column="5"
                        Style="{StaticResource IconButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="Close terminal"
                        AutomationProperties.Name="Close terminal">
                        <FontIcon Glyph="&#xE711;" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Output -->
            <ScrollViewer
                x:Name="OutputScroller"
                Grid.Row="1"
                Padding="12,8"
                VerticalScrollMode="Auto"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="OutputText"
                    FontFamily="{StaticResource CodeFontFamily}"
                    FontSize="12.5"
                    Foreground="{StaticResource TerminalTextBrush}"
                    TextWrapping="NoWrap"
                    IsTextSelectionEnabled="True"/>
            </ScrollViewer>

            <!-- Input -->
            <Grid Grid.Row="2" Padding="12,0,12,10" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock
                    Text="$"
                    Foreground="{StaticResource TerminalPromptBrush}"
                    FontFamily="{StaticResource CodeFontFamily}"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>
                <TextBox
                    x:Name="InputBox"
                    Grid.Column="1"
                    PlaceholderText="Type a command… (Enter to run)"
                    FontFamily="{StaticResource CodeFontFamily}"
                    FontSize="12.5"
                    MinHeight="30"
                    Padding="0,6,0,6"
                    Background="Transparent"
                    BorderThickness="0"
                    KeyDown="InputBox_KeyDown"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
