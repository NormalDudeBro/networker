<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="networker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:networker.Controls"
    Title="Networker">

    <Grid
        x:Name="Root"
        x:FieldModifier="public"
        Background="{ThemeResource AppBackgroundBrush}"
        KeyDown="Root_KeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="PaletteAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F5" Invoked="RefreshHealthAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>

        <Grid x:Name="ShellLayout" RowDefinitions="Auto,Auto,*,Auto">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ShellWidthStates">
                    <VisualState x:Name="CompactShell">
                        <VisualState.StateTriggers>
                            <controls:ElementWidthTrigger Source="{x:Bind ShellLayout}" MaxWidth="1099.999"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="WorkflowTabs.Visibility" Value="Collapsed"/>
                            <Setter Target="CompactWorkflowBar.Visibility" Value="Visible"/>
                            <Setter Target="WorkflowAnnouncement.Margin" Value="12,0,12,4"/>
                            <Setter Target="ShellFooter.Padding" Value="{StaticResource PagePaddingCompact}"/>
                            <Setter Target="FooterHints.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideShell">
                        <VisualState.StateTriggers>
                            <controls:ElementWidthTrigger Source="{x:Bind ShellLayout}" MinWidth="1100"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="WorkflowTabs.Visibility" Value="Visible"/>
                            <Setter Target="CompactWorkflowBar.Visibility" Value="Collapsed"/>
                            <Setter Target="FooterHints.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="ShellHeightStates">
                    <VisualState x:Name="ShortShell">
                        <VisualState.StateTriggers>
                            <controls:ElementHeightTrigger Source="{x:Bind ShellLayout}" MaxHeight="639.999"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="WorkflowTabs.Padding" Value="{StaticResource TabContentPaddingCompact}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="TallShell">
                        <VisualState.StateTriggers>
                            <controls:ElementHeightTrigger Source="{x:Bind ShellLayout}" MinHeight="640"/>
                        </VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <!-- Compact global header. Workflow titles live in the numbered strip. -->
            <Border
                Grid.Row="0"
                Padding="16,8"
                Background="{ThemeResource AppShellBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="{ThemeResource RadiusSM}" Background="{ThemeResource AppAccentMutedBrush}">
                            <FontIcon Glyph="&#xE968;" FontSize="16" Foreground="{ThemeResource AppAccentBrush}"/>
                        </Border>
                        <StackPanel Spacing="0">
                            <TextBlock Text="NETWORKER" Style="{StaticResource SectionLabelTextStyle}" Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                            <TextBlock Text="Troubleshooting workspace" Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="AI provider status">
                            <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDotStyle}" Fill="{ThemeResource AppTextDisabledBrush}"/>
                            <TextBlock x:Name="StatusText" Text="Not checked" Style="{StaticResource CaptionTextStyle}" MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="StatusRefreshButton" Style="{StaticResource IconButtonStyle}" Click="StatusRefreshButton_Click" ToolTipService.ToolTip="Check connection (F5)" AutomationProperties.Name="Check AI provider connection">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                        <Button x:Name="StatusThemeButton" Style="{StaticResource IconButtonStyle}" Click="ThemeButton_Click" ToolTipService.ToolTip="Cycle theme" AutomationProperties.Name="Cycle theme">
                            <FontIcon Glyph="&#xE790;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The full sequence stays visible and scrollable at the 720px minimum. -->
            <Border Grid.Row="1" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1">
                <Grid RowDefinitions="Auto,Auto">
                    <StackPanel x:Name="CompactWorkflowBar" Orientation="Horizontal" Spacing="8" Padding="12,8" Visibility="Collapsed">
                        <TextBlock Text="Stage" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center"/>
                        <ComboBox
                            x:Name="CompactWorkflowSelector"
                            ItemsSource="{x:Bind WorkflowItems}"
                            DisplayMemberPath="Label"
                            HorizontalAlignment="Stretch"
                            MinWidth="0"
                            Width="240"
                            SelectionChanged="CompactWorkflowSelector_SelectionChanged"
                            AutomationProperties.Name="Select workflow stage"/>
                        <TextBlock x:Name="CompactStageStatus" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ListView
                        x:Name="WorkflowTabs"
                        ItemsSource="{x:Bind WorkflowItems}"
                        SelectionChanged="WorkflowTabs_SelectionChanged"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        Padding="10,8,10,6"
                        Background="Transparent"
                        AutomationProperties.Name="Troubleshooting workflow stages">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinWidth" Value="112"/>
                                <Setter Property="MinHeight" Value="56"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="2,0"/>
                                <Setter Property="CornerRadius" Value="{ThemeResource RadiusSM}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="{Binding HelpText}">
                                    <Border
                                        Width="28" Height="28"
                                        CornerRadius="14"
                                        Background="{Binding NumberBackground}"
                                        BorderBrush="{Binding StatusBrush}"
                                        BorderThickness="1">
                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="{Binding StatusGlyph}" FontSize="10" Foreground="{Binding StatusBrush}"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="WorkflowAnnouncement"
                        Grid.Row="1"
                        Margin="18,0,18,5"
                        Style="{StaticResource CaptionTextStyle}"
                        AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Row="2"/>

            <Border x:Name="ShellFooter" Grid.Row="3" Background="{ThemeResource AppShellBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="10,6,12,6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PreviousButton" Style="{StaticResource SecondaryButtonStyle}" Click="PreviousButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72B;" FontSize="12"/><TextBlock Text="Previous"/></StackPanel>
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource PrimaryButtonStyle}" Click="NextButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Next"/><FontIcon Glyph="&#xE72A;" FontSize="12"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="StageDescription" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <StackPanel x:Name="FooterHints" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Style="{StaticResource KbdStyle}"><TextBlock Text="1-9  Stages" Style="{StaticResource CaptionTextStyle}"/></Border>
                        <Border Style="{StaticResource KbdStyle}"><TextBlock Text="Ctrl K  Commands" Style="{StaticResource CaptionTextStyle}"/></Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" MaxWidth="{StaticResource ToastMaxWidth}"/>
        <controls:CommandPalette x:Name="Palette" Visibility="Collapsed"/>
    </Grid>
</Window>
