<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- UI font prefers Inter, falls back to the system Segoe UI stack.
         Bundled binaries are intentionally avoided; install Inter/JetBrains Mono
         locally to pick them up. -->

    <FontFamily x:Key="AppFontFamily">Inter, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="CodeFontFamily">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

    <!-- ===================== Type scale ===================== -->
    <x:Double x:Key="FontSizeMicro">11</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeBodyLarge">16</x:Double>
    <x:Double x:Key="FontSizeSection">16</x:Double>
    <x:Double x:Key="FontSizeH3">18</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeH2">22</x:Double>
    <x:Double x:Key="FontSizeH1">26</x:Double>
    <x:Double x:Key="FontSizeCode">13</x:Double>

    <!-- ===================== Line heights ===================== -->
    <x:Double x:Key="LineHeightCaption">16</x:Double>
    <x:Double x:Key="LineHeightBody">20</x:Double>
    <x:Double x:Key="LineHeightSection">22</x:Double>
    <x:Double x:Key="LineHeightTitle">26</x:Double>
    <x:Double x:Key="LineHeightCode">18</x:Double>

    <!-- ===================== Spacing scale ===================== -->
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceSM">8</x:Double>
    <x:Double x:Key="SpaceMD">12</x:Double>
    <x:Double x:Key="SpaceLG">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>
    <x:Double x:Key="SpaceXXL">32</x:Double>

    <!-- ===================== Semantic layout ===================== -->
    <Thickness x:Key="PagePadding">20,16,20,12</Thickness>
    <Thickness x:Key="PagePaddingCompact">12,10,12,8</Thickness>
    <Thickness x:Key="DashboardPagePadding">20,16,20,16</Thickness>
    <Thickness x:Key="DashboardPagePaddingCompact">12,10,12,10</Thickness>
    <Thickness x:Key="TabContentPadding">0,12</Thickness>
    <Thickness x:Key="TabContentPaddingCompact">0,8</Thickness>
    <Thickness x:Key="SectionPanelPadding">16,14</Thickness>
    <Thickness x:Key="SectionPanelPaddingCompact">12,10</Thickness>
    <Thickness x:Key="WorkbenchHeaderPadding">20,14</Thickness>
    <Thickness x:Key="WorkbenchHeaderPaddingCompact">12,10</Thickness>
    <x:Double x:Key="ResponsiveContentMaxWidth">1200</x:Double>
    <x:Double x:Key="SettingsMaxWidth">880</x:Double>
    <Thickness x:Key="OverlayInset">16</Thickness>
    <x:Double x:Key="CommandPaletteMaxWidth">580</x:Double>
    <x:Double x:Key="CommandPaletteMaxHeight">560</x:Double>
    <x:Double x:Key="CodeBlockMaxHeight">480</x:Double>
    <x:Double x:Key="TechnicalEditorMinHeight">160</x:Double>
    <x:Double x:Key="TechnicalEditorMaxHeight">360</x:Double>
    <x:Double x:Key="ToastMaxWidth">400</x:Double>

    <!-- ===================== Radii ===================== -->
    <CornerRadius x:Key="RadiusXS">4</CornerRadius>
    <CornerRadius x:Key="RadiusSM">6</CornerRadius>
    <CornerRadius x:Key="RadiusMD">8</CornerRadius>
    <CornerRadius x:Key="RadiusLG">12</CornerRadius>
    <CornerRadius x:Key="RadiusXL">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

</ResourceDictionary>
