<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="networker.Views.AssistantPage"
    x:Name="AssistantPageRoot"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:networker.Controls"
    xmlns:models="using:networker.Models"
    xmlns:local="using:networker"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <controls:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <controls:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
        <controls:VerdictBrushConverter x:Key="VerdictBrush"/>

        <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:ChatMessage">
            <StackPanel HorizontalAlignment="Right" Spacing="4" Margin="0,0,0,12" MaxWidth="720">
                <Border Style="{StaticResource UserBubbleStyle}">
                    <TextBlock Style="{StaticResource UserBubbleTextStyle}" Text="{x:Bind Text}"/>
                </Border>
                <TextBlock Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" FontSize="11">
                    <Run Text="You"/><Run Text=" · "/><Run Text="{x:Bind Timestamp, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="models:ChatMessage">
            <StackPanel Spacing="6" Margin="0,0,0,16" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource CaptionTextStyle}" FontSize="11">
                    <Run Text="Assistant"/>
                    <Run Text="{x:Bind Provider, Mode=OneWay}" Foreground="{ThemeResource AppAccentBrush}"/>
                    <Run Text="{x:Bind Model, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock
                    Style="{StaticResource AssistantMessageTextStyle}"
                    Text="{x:Bind Text, Mode=OneWay}"/>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind IsStreaming, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressRing IsActive="True" Width="12" Height="12"/>
                    <TextBlock Text="Generating…" Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CodeMessageTemplate" x:DataType="models:ChatMessage">
            <StackPanel Spacing="4" Margin="0,0,0,16" MaxWidth="860" HorizontalAlignment="Left">
                <controls:CodeBlockView/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ErrorMessageTemplate" x:DataType="models:ChatMessage">
            <Border
                Margin="0,0,0,16"
                MaxWidth="720"
                HorizontalAlignment="Left"
                Background="{ThemeResource BadgeDangerBackgroundBrush}"
                BorderBrush="{ThemeResource AppDangerBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource RadiusMD}"
                Padding="14,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="Request failed" FontWeight="SemiBold" Foreground="{ThemeResource AppDangerBrush}"/>
                    <TextBlock Style="{StaticResource AssistantMessageTextStyle}" Text="{x:Bind Text}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===================== Activity block templates ===================== -->

        <DataTemplate x:Key="ThinkingBlockTemplate" x:DataType="models:ThinkingBlock">
            <Expander
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Margin="0,0,0,6">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9CE;" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Thinking" Style="{StaticResource FieldLabelTextStyle}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind MoreText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <TextBlock
                    Text="{x:Bind Content, Mode=OneWay}"
                    Style="{StaticResource MonoSecondaryTextStyle}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True"/>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="ToolBlockTemplate" x:DataType="models:ToolBlock">
            <Expander
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Margin="0,0,0,6">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind Action, Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind Detail, Mode=OneWay}"
                            Style="{StaticResource MonoSecondaryTextStyle}"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"/>
                        <ProgressRing
                            Grid.Column="3"
                            IsActive="True"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock
                            Grid.Column="4"
                            Text="{x:Bind VerdictDisplay, Mode=OneWay}"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Foreground="{x:Bind Verdict, Mode=OneWay, Converter={StaticResource VerdictBrush}}"/>
                    </Grid>
                </Expander.Header>
                <TextBlock
                    Text="{x:Bind Output, Mode=OneWay}"
                    Style="{StaticResource MonoTextStyle}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True"
                    Visibility="{x:Bind HasOutput, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="EditBlockTemplate" x:DataType="models:EditBlock">
            <Expander
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Margin="0,0,0,6">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                        <FontIcon Glyph="&#xE8AC;" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Edited" Style="{StaticResource FieldLabelTextStyle}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind FilePath, Mode=OneWay}"
                            Style="{StaticResource MonoSecondaryTextStyle}"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"/>
                        <TextBlock
                            Grid.Column="3"
                            Text="{x:Bind CountsText, Mode=OneWay}"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AppSuccessBrush}"
                            Visibility="{x:Bind HasCounts, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Expander.Header>
                <TextBlock
                    Text="{x:Bind Diff, Mode=OneWay}"
                    Style="{StaticResource MonoTextStyle}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True"
                    Visibility="{x:Bind HasDiff, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="ActivityBlockTemplate" x:DataType="models:ActivityLineBlock">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2,0,8">
                <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="{ThemeResource AppTextDisabledBrush}" VerticalAlignment="Center"/>
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind SummaryText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextStyle}"
                    FontSize="11"
                    Foreground="{ThemeResource AppTextDisabledBrush}"
                    TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ErrorBlockTemplate" x:DataType="models:ErrorBlock">
            <Border
                Background="{ThemeResource BadgeDangerBackgroundBrush}"
                BorderBrush="{ThemeResource AppDangerBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource RadiusSM}"
                Padding="10,8"
                Margin="0,0,0,6">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AppDangerBrush}" FontSize="12"/>
                    <TextBlock
                        Text="{x:Bind Message, Mode=OneWay}"
                        Style="{StaticResource MonoSecondaryTextStyle}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <controls:BlockTemplateSelector
            x:Key="BlockSelector"
            ThinkingTemplate="{StaticResource ThinkingBlockTemplate}"
            ToolTemplate="{StaticResource ToolBlockTemplate}"
            EditTemplate="{StaticResource EditBlockTemplate}"
            ActivityTemplate="{StaticResource ActivityBlockTemplate}"
            ErrorTemplate="{StaticResource ErrorBlockTemplate}"/>

        <!-- ===================== Structured assistant turn ===================== -->

        <DataTemplate x:Key="TurnTemplate" x:DataType="models:AssistantTurn">
            <StackPanel Spacing="6" Margin="0,0,0,16" MaxWidth="780" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource CaptionTextStyle}" FontSize="11">
                    <Run Text="Assistant"/>
                    <Run Text="{x:Bind Provider, Mode=OneWay}" Foreground="{ThemeResource AppAccentBrush}"/>
                    <Run Text="{x:Bind Model, Mode=OneWay}"/>
                </TextBlock>

                <ItemsControl
                    ItemsSource="{x:Bind Blocks, Mode=OneWay}"
                    ItemTemplateSelector="{StaticResource BlockSelector}"
                    Visibility="{x:Bind HasBlocks, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind IsBusyActivity, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressRing IsActive="True" Width="12" Height="12"/>
                    <TextBlock Text="Working: " Style="{StaticResource CaptionTextStyle}"/>
                    <TextBlock Text="{x:Bind BusyText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>

                <TextBlock
                    Style="{StaticResource AssistantMessageTextStyle}"
                    Text="{x:Bind Text, Mode=OneWay}"
                    Visibility="{x:Bind HasText, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind ShowGeneratingIndicator, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressRing IsActive="True" Width="12" Height="12"/>
                    <TextBlock Text="Generating…" Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>

                <TextBlock
                    Text="{x:Bind FooterText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextStyle}"
                    FontSize="11"
                    Foreground="{ThemeResource AppTextDisabledBrush}"
                    Visibility="{x:Bind IsStreaming, Mode=OneWay, Converter={StaticResource BoolToVisInverted}}"/>
            </StackPanel>
        </DataTemplate>

        <controls:MessageTemplateSelector
            x:Key="MessageSelector"
            UserTemplate="{StaticResource UserMessageTemplate}"
            AssistantTemplate="{StaticResource AssistantMessageTemplate}"
            CodeTemplate="{StaticResource CodeMessageTemplate}"
            ErrorTemplate="{StaticResource ErrorMessageTemplate}"
            TurnTemplate="{StaticResource TurnTemplate}"/>
    </Page.Resources>

    <Grid x:Name="MainLayout" SizeChanged="MainLayout_SizeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="ClosePanelAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AssistantWidthStates">
                <VisualState x:Name="NarrowAssistant">
                    <VisualState.StateTriggers>
                        <controls:ElementWidthTrigger Source="{x:Bind MainLayout}" MaxWidth="899.999"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AssistantPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="AssistantPanel.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="AssistantPanel.HorizontalAlignment" Value="Right"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideAssistant">
                    <VisualState.StateTriggers>
                        <controls:ElementWidthTrigger Source="{x:Bind MainLayout}" MinWidth="900"/>
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================= Header ======================= -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource WorkspaceHeaderStyle}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Style="{StaticResource PageHeaderStackStyle}" VerticalAlignment="Center">
                <TextBlock Text="STEP 8 OF 9" Style="{StaticResource PageEyebrowTextStyle}"/>
                <TextBlock Text="Assist" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="Escalate unresolved findings with optional evidence from the current troubleshooting workspace."/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button
                    x:Name="HeaderModelButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="PanelToggleButton_Click"
                    ToolTipService.ToolTip="Open session settings"
                    AutomationProperties.Name="Open session settings">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse x:Name="HeaderModelDot" Style="{StaticResource StatusDotStyle}" Fill="{ThemeResource AppOfflineBrush}"/>
                        <TextBlock x:Name="HeaderModelText" Text="Select a model" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
                <Button
                    x:Name="PanelToggleButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="PanelToggleButton_Click"
                    ToolTipService.ToolTip="Toggle history panel"
                    AutomationProperties.Name="Toggle history panel">
                    <FontIcon Glyph="&#xE8E7;" FontSize="16"/>
                </Button>
                <Button
                    x:Name="NewChatButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="NewChatButton_Click"
                    ToolTipService.ToolTip="New chat"
                    AutomationProperties.Name="New chat">
                    <FontIcon Glyph="&#xE8BD;" FontSize="16"/>
                </Button>
                <Button
                    x:Name="ClearHistoryButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="ClearHistoryButton_Click"
                    ToolTipService.ToolTip="Clear history"
                    AutomationProperties.Name="Clear history">
                    <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>
        </Border>

        <!-- ======================= Chat area ======================= -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Border x:Name="EmptyState" Style="{StaticResource EmptyStatePanelStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <Border
                        Width="42" Height="42"
                        CornerRadius="{ThemeResource RadiusSM}"
                        Background="{ThemeResource AppAccentMutedBrush}"
                        HorizontalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE8BD;" FontSize="20"
                            Foreground="{ThemeResource AppAccentBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Start a network investigation" Style="{StaticResource WorkspaceTitleTextStyle}" HorizontalAlignment="Center"/>
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        TextAlignment="Center"
                        MaxWidth="480"
                        Text="Ask about configuration behavior, troubleshooting, routing, logs, or an operational change. Local tools remain available beside the composer."/>
                    <ItemsControl HorizontalAlignment="Center" MaxWidth="480" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <Button Margin="0,0,8,8" Style="{StaticResource ChipButtonStyle}" Content="Calculate a subnet" Click="QuickStart_Click" Tag="ip"/>
                        <Button Margin="0,0,8,8" Style="{StaticResource ChipButtonStyle}" Content="Generate OSPF config" Click="QuickStart_Click" Tag="ospf"/>
                        <Button Margin="0,0,8,8" Style="{StaticResource ChipButtonStyle}" Content="Audit a config" Click="QuickStart_Click" Tag="audit"/>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ListView
                x:Name="MessagesList"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="False"
                ItemTemplateSelector="{StaticResource MessageSelector}"
                Padding="20,16,20,8"
                Background="Transparent"/>
        </Grid>

        <!-- ======================= Input ======================= -->
        <Grid Grid.Row="2" Grid.Column="0" Padding="20,8,20,16" RowDefinitions="Auto,Auto" RowSpacing="6">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <ToggleSwitch x:Name="AgentModeToggle" Header="Mode" OffContent="Chat" OnContent="Agent" Toggled="AgentModeToggle_Toggled"/>
                <Button x:Name="WorkspaceButton" Grid.Column="1" Content="Choose workspace" Click="WorkspaceButton_Click" Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"/>
                <TextBlock x:Name="WorkspacePathText" Grid.Column="2" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                <CheckBox x:Name="IncludeEvidenceCheckBox" Grid.Column="3" Content="Include workspace evidence" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="EvidenceSummaryText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Border
                Grid.Row="1"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource RadiusMD}"
                Padding="8,6">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Button
                        x:Name="LocalToolsButton"
                        Grid.Column="0"
                        Margin="0,0,4,0"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Run a local tool"
                        AutomationProperties.Name="Run a local deterministic tool">
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedLeft">
                                <MenuFlyoutItem Text="Subnet calculator" Tag="ip" Click="RunTool_Click"/>
                                <MenuFlyoutItem Text="OSPF configuration" Tag="ospf" Click="RunTool_Click"/>
                                <MenuFlyoutItem Text="BGP configuration" Tag="bgp" Click="RunTool_Click"/>
                                <MenuFlyoutItem Text="Configuration audit" Tag="audit" Click="RunTool_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Log analysis" Tag="logs" Click="RunTool_Click"/>
                                <MenuFlyoutItem Text="Topology discovery" Tag="topology" Click="RunTool_Click"/>
                                <MenuFlyoutItem Text="Configuration translation" Tag="translate" Click="RunTool_Click"/>
                                <MenuFlyoutItem Text="Troubleshooting playbook" Tag="playbook" Click="RunTool_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE713;" FontSize="15"/>
                    </Button>
                    <ScrollViewer
                        Grid.Column="1"
                        MaxHeight="160"
                        HorizontalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <TextBox
                            x:Name="InputBox"
                            PlaceholderText="Ask about network engineering… (Enter to send)"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            TextChanged="InputBox_TextChanged"
                            KeyDown="InputBox_KeyDown"
                            KeyUp="InputBox_KeyUp"
                            PreviewKeyDown="InputBox_PreviewKeyDown"
                            MinHeight="36"
                            BorderThickness="0"
                            Background="Transparent"/>
                    </ScrollViewer>
                    <Button
                        x:Name="CancelButton"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        Style="{StaticResource IconButtonStyle}"
                        Click="CancelButton_Click"
                        ToolTipService.ToolTip="Stop generation"
                        AutomationProperties.Name="Stop generation">
                        <FontIcon Glyph="&#xE711;" FontSize="14"/>
                    </Button>
                    <Button
                        x:Name="SendButton"
                        Grid.Column="3"
                        Margin="4,0,0,0"
                        IsEnabled="False"
                        Click="SendButton_Click"
                        ToolTipService.ToolTip="Send (Ctrl+Enter)"
                        AutomationProperties.Name="Send message"
                        Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE724;" FontSize="14"/>
                            <TextBlock Text="Send" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= Session panel ======================= -->
        <Button
            x:Name="SessionScrim"
            Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
            Visibility="Collapsed"
            Background="{ThemeResource AppScrimBrush}"
            BorderThickness="0"
            Padding="0"
            IsTabStop="False"
            Click="SessionScrim_Click"
            AutomationProperties.AccessibilityView="Raw"/>
        <Grid
            x:Name="AssistantPanel"
            Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
            Width="320"
            Visibility="Collapsed"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1,0,0,0"
            AutomationProperties.Name="Assistant session settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="16" Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Assist session" Style="{StaticResource SectionHeaderTextStyle}"/>
                            <TextBlock Text="Runtime status and current history" Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                        <Button
                            x:Name="ClosePanelButton"
                            Grid.Column="1"
                            Style="{StaticResource IconButtonStyle}"
                            Click="ClosePanelButton_Click"
                            ToolTipService.ToolTip="Close session settings"
                            AutomationProperties.Name="Close session settings">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                        </Button>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="PanelHealthDot" Width="8" Height="8" Fill="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.Name="AI provider status"/>
                            <TextBlock x:Name="PanelHealthText" Text="Not checked" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ChipButtonStyle}" Content="Check" Click="HealthCheckButton_Click" HorizontalAlignment="Right" Padding="10,4"/>
                    </Grid>

                    <Button Content="Configure AI in Settings" Style="{StaticResource SecondaryButtonStyle}" Click="ConfigureAiButton_Click" HorizontalAlignment="Stretch"/>

                    <Border Height="1" Background="{ThemeResource AppBorderBrush}"/>

                    <StackPanel Spacing="5">
                        <TextBlock Text="History" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="HistorySearchBox" PlaceholderText="Search messages…" TextChanged="HistorySearchBox_TextChanged"/>
                        <ListView x:Name="HistoryList" MaxHeight="160" SelectionMode="Single" ItemClick="HistoryList_ItemClick" IsItemClickEnabled="True">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:HistoryEntry">
                                    <TextBlock Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="13"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="Clear history" Click="ClearHistoryButton_Click" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
