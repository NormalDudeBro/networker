<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="networker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:networker"
    Title="networker">

    <NavigationView x:Name="NavView" ItemInvoked="NavView_ItemInvoked" IsBackButtonVisible="Collapsed">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="home" Icon="Home"/>
            <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting"/>
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" Margin="0"/>
    </NavigationView>
</Window>