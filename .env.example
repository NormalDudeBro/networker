# Networker AI provider configuration.
#
# Copy this file to `.env` (same directory as the app, or your Windows
# App SDK local app-data folder) and fill in values. Everything here is
# optional: with no values, the app runs against a local Ollama at the
# default endpoint. Do NOT commit your real `.env` to version control.
#
# Precedence: real environment variables > in-app settings > .env file > defaults.

# Primary provider: ollama | grok | gemini
LLM_PROVIDER=ollama

# Comma-separated fallback chain, tried in order if the primary fails.
# Example: LLM_FALLBACK_CHAIN=ollama,grok
LLM_FALLBACK_CHAIN=ollama

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
# OLLAMA_API_KEY=  # only needed if your Ollama is behind an auth proxy

# --- Grok (xAI) ---
XAI_API_KEY=
XAI_MODEL=grok-3

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
