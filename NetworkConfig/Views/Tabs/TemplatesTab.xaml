<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="networker.NetworkConfig.Views.Tabs.TemplatesTab"
    x:Name="TemplatesRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:networker.NetworkConfig.Views.Tabs"
    xmlns:controls="using:networker.Controls">

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="TemplateWidthStates">
                <VisualState x:Name="NarrowTemplates">
                    <VisualState.StateTriggers>
                        <controls:ElementWidthTrigger Source="{x:Bind TemplatesRoot}" MaxWidth="759.999"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TemplateListColumn.Width" Value="*"/>
                        <Setter Target="TemplateDetailColumn.Width" Value="0*"/>
                    <Setter Target="TemplateListCard.(Grid.ColumnSpan)" Value="2"/>
                    <Setter Target="TemplateDetailCard.(Grid.Row)" Value="1"/>
                    <Setter Target="TemplateDetailCard.(Grid.Column)" Value="0"/>
                    <Setter Target="TemplateDetailCard.(Grid.ColumnSpan)" Value="2"/>
                    <Setter Target="TemplateList.MinHeight" Value="180"/>
                </VisualState.Setters>
            </VisualState>
                <VisualState x:Name="WideTemplates">
                    <VisualState.StateTriggers>
                        <controls:ElementWidthTrigger Source="{x:Bind TemplatesRoot}" MinWidth="760"/>
                </VisualState.StateTriggers>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <ScrollViewer Style="{StaticResource WorkflowScrollViewerStyle}">
    <Grid Padding="{StaticResource TabContentPadding}" ColumnSpacing="12" RowSpacing="12" MaxWidth="1200" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TemplateListColumn" Width="320"/>
            <ColumnDefinition x:Name="TemplateDetailColumn" Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="TemplateListCard" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="Templates" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="Predefined device templates plus any custom templates you save. Select one to preview the generated configuration."/>
                <ListView x:Name="TemplateList" SelectionChanged="TemplateList_SelectionChanged" MinHeight="320" ItemContainerStyle="{StaticResource DenseNavigationListItemStyle}" AutomationProperties.Name="Available configuration templates">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TemplateListItem">
                            <StackPanel Spacing="3" Padding="0,4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                    <Border Style="{StaticResource BadgeInfoStyle}" Padding="8,1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind BadgeText}" Style="{StaticResource BadgeTextStyle}" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <Border x:Name="TemplateDetailCard" Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="10">
                <Border x:Name="EmptyDetailPanel" Style="{StaticResource EmptyStatePanelStyle}" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Select a template" FontWeight="SemiBold"/>
                            <TextBlock Text="Choose a built-in or custom template to preview its generated configuration." Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel x:Name="TemplateDetailPanel" Visibility="Collapsed" Spacing="10">
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock x:Name="DetailMeta" Style="{StaticResource CaptionTextStyle}"/>
                    <controls:CodeBlockView x:Name="DetailPreview"/>
                    <Button x:Name="DeleteButton" Content="Delete custom template" Click="Delete_Click" Style="{StaticResource DangerButtonStyle}" Visibility="Collapsed" HorizontalAlignment="Left"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource InlineStatusTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
