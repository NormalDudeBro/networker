<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="networker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:networker"
    xmlns:controls="using:networker.Controls"
    Title="Networker Copilot">

    <Grid x:Name="Root" x:FieldModifier="public">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="PaletteAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F5" Invoked="RefreshHealthAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>

        <NavigationView
            x:Name="NavView"
            ItemInvoked="NavView_ItemInvoked"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="220"
            CompactPaneLength="48"
            Background="{ThemeResource AppBackgroundBrush}">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" Icon="Home"/>
                <NavigationViewItem Content="Tools" Tag="tools" Icon="World"/>
                <NavigationViewItem Content="Network Config" Tag="networkconfig" Icon="Code"/>
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting"/>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Padding="12,0,12,12" Spacing="4">
                    <TextBlock Text="Networker Copilot" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                    <TextBlock Text="Local-first network assistant" Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <Grid x:Name="OverlayHost" IsHitTestVisible="False" Background="Transparent">
            <StackPanel
                x:Name="ToastHost"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,8,0"
                Spacing="0"
                IsHitTestVisible="True"/>
            <controls:CommandPalette x:Name="Palette" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>

