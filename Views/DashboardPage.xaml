<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="networker.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:networker.Models"
    xmlns:local="using:networker.Views"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid Padding="24,20,24,24" RowDefinitions="Auto,*">

        <!-- ======================= Header ======================= -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Overview" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Workspace status, quick access to the toolkit, and recent activity." Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>
            <Button
                Grid.Column="1"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="NewChatButton_Click"
                VerticalAlignment="Center"
                AutomationProperties.Name="Start a new chat">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8BD;" FontSize="14"/>
                    <TextBlock Text="New chat"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0" ColumnDefinitions="*,348" ColumnSpacing="16">

            <!-- ======================= Left column ======================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <!-- Quick actions -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Quick actions" Style="{StaticResource SectionLabelTextStyle}"/>
                            <GridView
                                x:Name="QuickActionsGrid"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="QuickAction_Click">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="MinWidth" Value="160"/>
                                        <Setter Property="MinHeight" Value="84"/>
                                        <Setter Property="Margin" Value="0,0,10,10"/>
                                        <Setter Property="Padding" Value="12"/>
                                        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="{ThemeResource FontSizeBody}"/>
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/>
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:QuickAction">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Grid Width="28" Height="28">
                                                <Border
                                                    CornerRadius="8"
                                                    Background="{ThemeResource AppAccentBrush}"
                                                    Opacity="0.12"/>
                                                <FontIcon
                                                    Glyph="{x:Bind Glyph}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource AppAccentBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Grid>
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock
                                                Text="{x:Bind Subtitle}"
                                                Style="{StaticResource CaptionTextStyle}"
                                                MaxLines="2"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Border>

                    <!-- Recent activity -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Recent activity" Style="{StaticResource SectionLabelTextStyle}"/>
                            <TextBlock
                                x:Name="ActivityEmpty"
                                Text="Tool runs and generated configs will show up here as you work."
                                Style="{StaticResource CaptionTextStyle}"/>
                            <ItemsControl x:Name="ActivityList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ActivityItem">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,8">
                                            <Border
                                                Grid.Column="0"
                                                Width="30" Height="30"
                                                CornerRadius="8"
                                                Background="{ThemeResource AppSurfaceBrush}"
                                                BorderBrush="{ThemeResource AppBorderBrush}"
                                                BorderThickness="1">
                                                <FontIcon
                                                    Glyph="{x:Bind Glyph}"
                                                    FontSize="13"
                                                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock
                                                    Text="{x:Bind Detail}"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis"
                                                    MaxLines="1"/>
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                Style="{StaticResource CaptionTextStyle}"
                                                Foreground="{ThemeResource AppTextDisabledBrush}"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind RelativeTime}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================= Right column ======================= -->
            <StackPanel Grid.Column="1" Spacing="16">

                <!-- AI connection -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="AI connection" Style="{StaticResource SectionLabelTextStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse
                                x:Name="AiStatusDot"
                                Width="10" Height="10"
                                Fill="{ThemeResource AppTextDisabledBrush}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="AI connection status"/>
                            <TextBlock x:Name="AiStatusText" Text="Not checked" VerticalAlignment="Center"/>
                            <ProgressRing x:Name="AiRefreshRing" IsActive="False" Width="14" Height="14" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="84,*">
                                <TextBlock Text="Provider" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource AppTextDisabledBrush}"/>
                                <TextBlock
                                    x:Name="AiProviderText"
                                    Grid.Column="1"
                                    FontFamily="{ThemeResource CodeFontFamily}"
                                    FontSize="12"
                                    VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="84,*">
                                <TextBlock Text="Model" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource AppTextDisabledBrush}"/>
                                <TextBlock
                                    x:Name="AiModelText"
                                    Grid.Column="1"
                                    FontFamily="{ThemeResource CodeFontFamily}"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Check now" Style="{StaticResource SecondaryButtonStyle}" Click="AiCheckButton_Click"/>
                            <Button Content="Configure…" Style="{StaticResource GhostButtonStyle}" Click="AiConfigureButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Keyboard shortcuts -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionLabelTextStyle}"/>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Style="{StaticResource KbdStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource CaptionTextStyle}"/>
                                        <TextBlock Text="K" Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Command palette" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Style="{StaticResource KbdStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource CaptionTextStyle}"/>
                                        <TextBlock Text="1–5" Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Jump to a page" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Style="{StaticResource KbdStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource CaptionTextStyle}"/>
                                        <TextBlock Text="F5" Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Check AI connection" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Style="{StaticResource KbdStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource CaptionTextStyle}"/>
                                        <TextBlock Text="Enter" Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Send / run a tool" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
