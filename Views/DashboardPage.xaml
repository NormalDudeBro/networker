<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="networker.Views.DashboardPage"
    x:Name="DashboardPageRoot"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:networker.Controls"
    xmlns:models="using:networker.Models"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid x:Name="DashboardLayout" RowDefinitions="Auto,*">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DashboardWidthStates">
                <VisualState x:Name="CompactDashboard">
                    <VisualState.StateTriggers>
                        <controls:ElementWidthTrigger Source="{x:Bind DashboardLayout}" MaxWidth="1099.999"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DashboardMainColumn.Width" Value="*"/>
                        <Setter Target="DashboardSideColumn.Width" Value="*"/>
                        <Setter Target="IncidentPanel.(Grid.Row)" Value="0"/>
                        <Setter Target="IncidentPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="IncidentPanel.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="DashboardSidePanel.(Grid.Row)" Value="1"/>
                        <Setter Target="DashboardSidePanel.(Grid.Column)" Value="0"/>
                        <Setter Target="DashboardSidePanel.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="DashboardGrid.Padding" Value="{StaticResource DashboardPagePaddingCompact}"/>
                        <Setter Target="DashboardPageHeader.Padding" Value="{StaticResource CompactPageHeaderPadding}"/>
                        <Setter Target="DashboardSubtitle.Visibility" Value="Collapsed"/>
                        <Setter Target="IncidentPanel.Padding" Value="{StaticResource SectionPanelPaddingCompact}"/>
                        <Setter Target="SymptomsInput.MinHeight" Value="72"/>
                        <Setter Target="SymptomsInput.MaxHeight" Value="120"/>
                        <Setter Target="ContextInput.MinHeight" Value="52"/>
                        <Setter Target="ContextInput.MaxHeight" Value="96"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideDashboard">
                    <VisualState.StateTriggers>
                        <controls:ElementWidthTrigger Source="{x:Bind DashboardLayout}" MinWidth="1100"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DashboardMainColumn.Width" Value="1.5*"/>
                        <Setter Target="DashboardSideColumn.Width" Value="*"/>
                        <Setter Target="IncidentPanel.(Grid.Row)" Value="0"/>
                        <Setter Target="IncidentPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="IncidentPanel.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="DashboardSidePanel.(Grid.Row)" Value="0"/>
                        <Setter Target="DashboardSidePanel.(Grid.Column)" Value="1"/>
                        <Setter Target="DashboardSidePanel.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="DashboardGrid.Padding" Value="{StaticResource DashboardPagePadding}"/>
                        <Setter Target="DashboardPageHeader.Padding" Value="{StaticResource WorkbenchHeaderPadding}"/>
                        <Setter Target="DashboardSubtitle.Visibility" Value="Visible"/>
                        <Setter Target="IncidentPanel.Padding" Value="{StaticResource SectionPanelPadding}"/>
                        <Setter Target="SymptomsInput.MinHeight" Value="120"/>
                        <Setter Target="SymptomsInput.MaxHeight" Value="240"/>
                        <Setter Target="ContextInput.MinHeight" Value="76"/>
                        <Setter Target="ContextInput.MaxHeight" Value="160"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="DashboardPageHeader" Style="{StaticResource WorkspaceHeaderStyle}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Style="{StaticResource PageHeaderStackStyle}">
                    <TextBlock Text="STEP 1 OF 9" Style="{StaticResource PageEyebrowTextStyle}"/>
                    <TextBlock Text="Start" Style="{StaticResource PageTitleTextStyle}"/>
                    <TextBlock x:Name="DashboardSubtitle" Text="Capture the incident once, then carry its evidence through the troubleshooting workflow." Style="{StaticResource PageSubtitleTextStyle}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Clear workspace" Style="{StaticResource DangerButtonStyle}" Click="ClearWorkspace_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid
                x:Name="CenteredDashboardCanvas"
                Width="{Binding ActualWidth, ElementName=DashboardPageRoot}"
                MaxWidth="1240"
                HorizontalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="DashboardGrid" Padding="20,16" ColumnSpacing="14" RowSpacing="14" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DashboardMainColumn" Width="1.5*"/>
                    <ColumnDefinition x:Name="DashboardSideColumn" Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <Border x:Name="IncidentPanel" Style="{StaticResource ToolInputPanelStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="INCIDENT INTAKE" Style="{StaticResource SectionLabelTextStyle}"/>
                            <TextBlock Text="Required details stay with the latest workspace across restarts." Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="IncidentTitleLabel" Text="Incident title *" Style="{StaticResource FieldLabelTextStyle}"/>
                            <TextBox x:Name="IncidentTitleInput" PlaceholderText="e.g. Branch BGP session instability" TextChanged="IncidentInput_TextChanged" AutomationProperties.LabeledBy="{x:Bind IncidentTitleLabel}"/>
                            <TextBlock x:Name="IncidentTitleError" Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="SymptomsLabel" Text="Symptoms and known evidence *" Style="{StaticResource FieldLabelTextStyle}"/>
                            <TextBox x:Name="SymptomsInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="240" PlaceholderText="Describe impact, timing, affected devices, and evidence already collected." TextChanged="IncidentInput_TextChanged" AutomationProperties.LabeledBy="{x:Bind SymptomsLabel}"/>
                            <TextBlock x:Name="SymptomsError" Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="ContextLabel" Text="Environment and constraints" Style="{StaticResource FieldLabelTextStyle}"/>
                            <TextBox x:Name="ContextInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" MaxHeight="160" PlaceholderText="Maintenance window, vendor mix, change limits, or escalation context." TextChanged="IncidentInput_TextChanged" AutomationProperties.LabeledBy="{x:Bind ContextLabel}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="StartButton" Content="Start investigation" Style="{StaticResource PrimaryButtonStyle}" Click="StartInvestigation_Click"/>
                            <TextBlock x:Name="WorkspaceStatus" Style="{StaticResource InlineStatusTextStyle}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="DashboardSidePanel" Grid.Column="1" Spacing="14">
                    <Border Style="{StaticResource InsetPanelStyle}">
                        <StackPanel Spacing="9">
                            <TextBlock Text="WORKSPACE STATUS" Style="{StaticResource SectionLabelTextStyle}"/>
                            <TextBlock x:Name="ProgressText" Text="0 of 8 action stages completed" Style="{StaticResource CardTitleTextStyle}"/>
                            <ProgressBar x:Name="WorkflowProgress" Minimum="0" Maximum="8"/>
                            <TextBlock x:Name="UpdatedText" Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InsetPanelStyle}">
                        <StackPanel Spacing="9">
                            <TextBlock Text="AI RUNTIME" Style="{StaticResource SectionLabelTextStyle}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="AiStatusDot" Style="{StaticResource StatusDotStyle}" Fill="{ThemeResource AppTextDisabledBrush}"/>
                                <TextBlock x:Name="AiStatusText" Text="Not checked" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="AiModelText" Style="{StaticResource MonoSecondaryTextStyle}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Check" Style="{StaticResource SecondaryButtonStyle}" Click="AiCheckButton_Click"/>
                                <Button Content="Configure" Style="{StaticResource GhostButtonStyle}" Click="AiConfigureButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ToolInputPanelStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource SectionLabelTextStyle}"/>
                                <TextBlock Text="Actions completed in this troubleshooting workspace." Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Saved locally" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                        </Grid>
                        <Border x:Name="ActivityEmpty" Style="{StaticResource EmptyStatePanelStyle}" HorizontalAlignment="Stretch">
                            <TextBlock Text="No activity yet. Start the incident, then inspect a configuration or log." Style="{StaticResource CaptionTextStyle}"/>
                        </Border>
                        <ItemsControl x:Name="ActivityList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ActivityItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="2,7">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="{ThemeResource AppAccentBrush}"/>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind RelativeTime}" Style="{StaticResource CaptionTextStyle}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
