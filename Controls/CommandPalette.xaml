<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="networker.Controls.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:networker.Controls"
    IsTabStop="False">

    <Border x:Name="Scrim" Background="{ThemeResource AppScrimBrush}">
        <Border
            x:Name="Panel"
            Width="580"
            MaxHeight="560"
            Margin="0,96,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource CardStyle}"
            Padding="0"
            KeyDown="Panel_KeyDown">

            <StackPanel>
                <Grid Padding="14,10" ColumnDefinitions="Auto,*">
                    <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        BorderThickness="0"
                        Background="Transparent"
                        PlaceholderText="Type a command or search…"
                        TextChanged="SearchBox_TextChanged"
                        KeyDown="SearchBox_KeyDown"/>
                </Grid>

                <Border Height="1" Background="{ThemeResource AppBorderBrush}"/>

                <ListView
                    x:Name="CommandList"
                    MaxHeight="360"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="CommandList_ItemClick"
                    Background="Transparent"
                    BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PaletteCommand">
                            <Grid Padding="12,8" ColumnDefinitions="Auto,*,Auto">
                                <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                    <TextBlock Text="{x:Bind Title}" FontSize="{ThemeResource FontSizeBody}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Height="1" Background="{ThemeResource AppBorderBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="16" Padding="14,8" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource CaptionTextStyle}">&#x2191;&#x2193; Navigate</TextBlock>
                    <TextBlock Style="{StaticResource CaptionTextStyle}">Enter Run</TextBlock>
                    <TextBlock Style="{StaticResource CaptionTextStyle}">Esc Close</TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
