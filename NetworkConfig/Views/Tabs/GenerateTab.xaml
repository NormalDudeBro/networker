<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="networker.NetworkConfig.Views.Tabs.GenerateTab"
    x:Name="GenerateRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:networker.NetworkConfig.Views.Tabs"
    xmlns:services="using:Networker.Core.Services.NetworkConfig"
    xmlns:controls="using:networker.Controls">

    <Grid x:Name="GenerateLayout" RowDefinitions="Auto,*">
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="GenerateWidthStates">
            <VisualState x:Name="NarrowGenerate">
                <VisualState.StateTriggers>
                        <controls:ElementWidthTrigger Source="{x:Bind GenerateRoot}" MaxWidth="1099.999"/>
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="TemplateSelector.(Grid.ColumnSpan)" Value="3"/>
                    <Setter Target="ApplyTemplateButton.(Grid.Row)" Value="1"/>
                    <Setter Target="ApplyTemplateButton.(Grid.Column)" Value="0"/>
                    <Setter Target="GenerateButton.(Grid.Row)" Value="1"/>
                    <Setter Target="GenerateButton.(Grid.Column)" Value="1"/>
                    <Setter Target="GenerateButton.(Grid.ColumnSpan)" Value="2"/>

                    <Setter Target="AclNameInput.(Grid.ColumnSpan)" Value="3"/>
                    <Setter Target="AclTypeLabel.(Grid.Row)" Value="1"/>
                    <Setter Target="AclTypeLabel.(Grid.Column)" Value="0"/>
                    <Setter Target="AclTypeCombo.(Grid.Row)" Value="1"/>
                    <Setter Target="AclTypeCombo.(Grid.Column)" Value="1"/>
                    <Setter Target="AclTypeCombo.(Grid.ColumnSpan)" Value="3"/>

                    <Setter Target="OspfProcessInput.(Grid.ColumnSpan)" Value="3"/>
                    <Setter Target="OspfRouterIdLabel.(Grid.Row)" Value="1"/>
                    <Setter Target="OspfRouterIdLabel.(Grid.Column)" Value="0"/>
                    <Setter Target="OspfRouterIdInput.(Grid.Row)" Value="1"/>
                    <Setter Target="OspfRouterIdInput.(Grid.Column)" Value="1"/>
                    <Setter Target="OspfRouterIdInput.(Grid.ColumnSpan)" Value="3"/>
                    <Setter Target="OspfRefBwLabel.(Grid.Row)" Value="2"/>
                    <Setter Target="OspfRefBwInput.(Grid.Row)" Value="2"/>
                    <Setter Target="OspfRefBwInput.(Grid.ColumnSpan)" Value="3"/>
                    <Setter Target="OspfPassiveLabel.(Grid.Row)" Value="3"/>
                    <Setter Target="OspfPassiveLabel.(Grid.Column)" Value="0"/>
                    <Setter Target="OspfPassiveInput.(Grid.Row)" Value="3"/>
                    <Setter Target="OspfPassiveInput.(Grid.Column)" Value="1"/>
                    <Setter Target="OspfPassiveInput.(Grid.ColumnSpan)" Value="3"/>

                    <Setter Target="BgpAsInput.(Grid.ColumnSpan)" Value="3"/>
                    <Setter Target="BgpRouterIdLabel.(Grid.Row)" Value="1"/>
                    <Setter Target="BgpRouterIdLabel.(Grid.Column)" Value="0"/>
                    <Setter Target="BgpRouterIdInput.(Grid.Row)" Value="1"/>
                    <Setter Target="BgpRouterIdInput.(Grid.Column)" Value="1"/>
                    <Setter Target="BgpRouterIdInput.(Grid.ColumnSpan)" Value="3"/>

                    <Setter Target="EigrpAsInput.(Grid.ColumnSpan)" Value="3"/>
                    <Setter Target="EigrpRouterIdLabel.(Grid.Row)" Value="1"/>
                    <Setter Target="EigrpRouterIdLabel.(Grid.Column)" Value="0"/>
                    <Setter Target="EigrpRouterIdInput.(Grid.Row)" Value="1"/>
                    <Setter Target="EigrpRouterIdInput.(Grid.Column)" Value="1"/>
                    <Setter Target="EigrpRouterIdInput.(Grid.ColumnSpan)" Value="3"/>
                    <Setter Target="EigrpNamedModeCheck.(Grid.Row)" Value="2"/>
                    <Setter Target="EigrpNameInput.(Grid.Row)" Value="2"/>
                    <Setter Target="EigrpNameInput.(Grid.ColumnSpan)" Value="3"/>
                    <Setter Target="EigrpPassiveLabel.(Grid.Row)" Value="3"/>
                    <Setter Target="EigrpPassiveLabel.(Grid.Column)" Value="0"/>
                    <Setter Target="EigrpPassiveInput.(Grid.Row)" Value="3"/>
                    <Setter Target="EigrpPassiveInput.(Grid.Column)" Value="1"/>
                    <Setter Target="EigrpPassiveInput.(Grid.ColumnSpan)" Value="3"/>

                    <Setter Target="StpModeCombo.(Grid.ColumnSpan)" Value="3"/>
                    <Setter Target="StpPriorityLabel.(Grid.Row)" Value="1"/>
                    <Setter Target="StpPriorityLabel.(Grid.Column)" Value="0"/>
                    <Setter Target="StpPriorityInput.(Grid.Row)" Value="1"/>
                    <Setter Target="StpPriorityInput.(Grid.Column)" Value="1"/>
                    <Setter Target="StpPriorityInput.(Grid.ColumnSpan)" Value="3"/>
                    <Setter Target="StpRootPrimaryLabel.(Grid.Row)" Value="2"/>
                    <Setter Target="StpRootPrimaryInput.(Grid.Row)" Value="2"/>
                    <Setter Target="StpRootPrimaryInput.(Grid.ColumnSpan)" Value="3"/>
                    <Setter Target="StpRootSecondaryLabel.(Grid.Row)" Value="3"/>
                    <Setter Target="StpRootSecondaryLabel.(Grid.Column)" Value="0"/>
                    <Setter Target="StpRootSecondaryInput.(Grid.Row)" Value="3"/>
                    <Setter Target="StpRootSecondaryInput.(Grid.Column)" Value="1"/>
                    <Setter Target="StpRootSecondaryInput.(Grid.ColumnSpan)" Value="3"/>
                    <Setter Target="StpPortfastCheck.(Grid.Row)" Value="4"/>
                    <Setter Target="StpPortfastCheck.(Grid.ColumnSpan)" Value="4"/>
                    <Setter Target="StpBpduguardCheck.(Grid.Row)" Value="5"/>
                    <Setter Target="StpBpduguardCheck.(Grid.Column)" Value="0"/>
                    <Setter Target="StpBpduguardCheck.(Grid.ColumnSpan)" Value="4"/>
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="WideGenerate">
                <VisualState.StateTriggers>
                        <controls:ElementWidthTrigger Source="{x:Bind GenerateRoot}" MinWidth="1100"/>
                </VisualState.StateTriggers>
            </VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="GenerateWorkbenchStates">
            <VisualState x:Name="StackedGenerateWorkbench">
                <VisualState.StateTriggers>
                        <controls:ElementWidthTrigger Source="{x:Bind GenerateLayout}" MaxWidth="1099.999"/>
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="GenerateOutputColumn.Width" Value="0*"/>
                    <Setter Target="OutputWorkbench.(Grid.Row)" Value="1"/>
                    <Setter Target="OutputWorkbench.(Grid.Column)" Value="0"/>
                    <Setter Target="OutputWorkbench.(Grid.ColumnSpan)" Value="2"/>
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="SplitGenerateWorkbench">
                <VisualState.StateTriggers>
                        <controls:ElementWidthTrigger Source="{x:Bind GenerateLayout}" MinWidth="1100"/>
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="GenerateOutputColumn.Width" Value="420"/>
                    <Setter Target="OutputWorkbench.(Grid.Row)" Value="0"/>
                    <Setter Target="OutputWorkbench.(Grid.Column)" Value="1"/>
                    <Setter Target="OutputWorkbench.(Grid.ColumnSpan)" Value="1"/>
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border Grid.Row="0" Style="{StaticResource WorkspaceHeaderStyle}">
        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <ComboBox x:Name="TemplateSelector" DisplayMemberPath="Name" PlaceholderText="Select a configuration template" AutomationProperties.Name="Configuration template"/>
            <Button x:Name="ApplyTemplateButton" Grid.Column="1" Content="Apply template" Click="ApplyTemplate_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="GenerateButton" Grid.Column="2" Content="Generate configuration" Style="{StaticResource PrimaryButtonStyle}" Click="Generate_Click">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" ScopeOwner="{x:Bind GenerateRoot}"/>
                </Button.KeyboardAccelerators>
            </Button>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" x:Name="StatusText" Style="{StaticResource InlineStatusTextStyle}" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Border>

    <Grid Grid.Row="1">
        <Grid
            Width="{Binding ActualWidth, ElementName=GenerateLayout}"
            MaxWidth="1200"
            HorizontalAlignment="Center">
            <ScrollViewer Style="{StaticResource WorkflowScrollViewerStyle}">
                <Grid Padding="{StaticResource TabContentPadding}" ColumnSpacing="12" RowSpacing="12" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="GenerateOutputColumn" Width="420"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="14">

            <!-- ===================== Device Basics ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Device Basics" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Vendor" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <ComboBox x:Name="VendorSelector" Grid.Row="0" Grid.Column="1" MaxWidth="260" HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Hostname" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="HostnameInput" Grid.Row="1" Grid.Column="1" PlaceholderText="e.g. core-router-01"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Domain Name" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="DomainInput" Grid.Row="2" Grid.Column="1" PlaceholderText="e.g. example.com"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Enable Secret" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <PasswordBox x:Name="EnableInput" Grid.Row="3" Grid.Column="1" PlaceholderText="Optional privileged EXEC secret"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="DNS Servers" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="DnsInput" Grid.Row="4" Grid.Column="1" PlaceholderText="Comma-separated, e.g. 8.8.8.8, 8.8.4.4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="NTP Servers" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="NtpInput" Grid.Row="5" Grid.Column="1" PlaceholderText="Comma-separated, e.g. pool.ntp.org"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== Interfaces ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Interfaces" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel MinWidth="820">
                            <Grid ColumnDefinitions="170,80,*,130,150,88" ColumnSpacing="8" Margin="0,0,0,6">
                                <TextBlock Text="TYPE" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="NUMBER" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="2" Text="DESCRIPTION" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="3" Text="IP ADDRESS" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="4" Text="SUBNET MASK" Style="{StaticResource TableHeaderTextStyle}"/>
                            </Grid>
                            <ItemsControl x:Name="InterfaceRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:TemplateInterfaceEntry">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" MinWidth="160"
                                                  ItemsSource="{x:Bind local:GenerateTab.InterfaceTypeOptions}"
                                                  SelectedItem="{x:Bind Type, Mode=TwoWay}"/>
                                        <TextBox Grid.Column="1" Text="{x:Bind Number, Mode=TwoWay}" PlaceholderText="Number"/>
                                        <TextBox Grid.Column="2" Text="{x:Bind Description, Mode=TwoWay}" PlaceholderText="Description"/>
                                        <TextBox Grid.Column="3" Text="{x:Bind Ip, Mode=TwoWay}" PlaceholderText="IP address"/>
                                        <TextBox Grid.Column="4" Text="{x:Bind Mask, Mode=TwoWay}" PlaceholderText="Subnet mask"/>
                                        <Button Grid.Column="5" Content="Remove" Click="RemoveInterface_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Content="Add Interface" Click="AddInterface_Click" HorizontalAlignment="Left" Style="{StaticResource ChipButtonStyle}"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="Interface names are derived from the type and vendor automatically (e.g. GigabitEthernet0/0, ge-0/0/0, Ethernet1). Rows without a number are ignored."/>
                </StackPanel>
            </Border>

            <!-- ===================== VLANs & Static Routes ===================== -->
            <Border Style="{StaticResource ToolInputPanelStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="VLANs &amp; Static Routes" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="VLANs — one per line: vlan_id,name" Style="{StaticResource FieldLabelTextStyle}"/>
                    <TextBox x:Name="VlansInput" AcceptsReturn="True" TextWrapping="Wrap" Height="88"
                             PlaceholderText="10,MANAGEMENT&#x0a;20,DATA&#x0a;30,VOICE"/>
                    <TextBlock Text="Static Routes — one per line: destination,mask,next-hop" Style="{StaticResource FieldLabelTextStyle}"/>
                    <TextBox x:Name="RoutesInput" AcceptsReturn="True" TextWrapping="Wrap" Height="88"
                             PlaceholderText="0.0.0.0,0.0.0.0,10.0.0.1"/>
                </StackPanel>
            </Border>

            <!-- ===================== ACL ===================== -->
            <Border Style="{StaticResource ToolInputPanelStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Access Control List" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="8" RowDefinitions="Auto,Auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ACL Name" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="AclNameInput" Grid.Column="1" PlaceholderText="e.g. INBOUND-FILTER"/>
                        <TextBlock x:Name="AclTypeLabel" Grid.Column="2" Text="Type" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <ComboBox x:Name="AclTypeCombo" Grid.Column="3" ItemsSource="{x:Bind local:GenerateTab.AclTypeOptions}" SelectedIndex="1"/>
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="The ACL is included only when a name is set and at least one entry has a sequence and source."/>
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel MinWidth="970">
                            <Grid ColumnDefinitions="50,75,70,110,95,110,95,70,70,88" ColumnSpacing="6" Margin="0,0,0,6">
                                <TextBlock Text="SEQ" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="ACTION" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="2" Text="PROTO" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="3" Text="SOURCE" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="4" Text="SRC MASK" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="5" Text="DESTINATION" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="6" Text="DST MASK" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="7" Text="PORT" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="8" Text="LOG" Style="{StaticResource TableHeaderTextStyle}"/>
                            </Grid>
                            <ItemsControl x:Name="AclEntryRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:TemplateAclEntry">
                                        <Grid ColumnSpacing="6" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{x:Bind Sequence, Mode=TwoWay}" PlaceholderText="Seq"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind local:GenerateTab.AclActionOptions}"
                                                  SelectedItem="{x:Bind Action, Mode=TwoWay}"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{x:Bind local:GenerateTab.AclProtocolOptions}"
                                                  SelectedItem="{x:Bind Protocol, Mode=TwoWay}"/>
                                        <TextBox Grid.Column="3" Text="{x:Bind Source, Mode=TwoWay}" PlaceholderText="Source"/>
                                        <TextBox Grid.Column="4" Text="{x:Bind SourceWildcard, Mode=TwoWay}" PlaceholderText="Src wildcard"/>
                                        <TextBox Grid.Column="5" Text="{x:Bind Destination, Mode=TwoWay}" PlaceholderText="Destination"/>
                                        <TextBox Grid.Column="6" Text="{x:Bind DestinationWildcard, Mode=TwoWay}" PlaceholderText="Dst wildcard"/>
                                        <TextBox Grid.Column="7" Text="{x:Bind DestinationPort, Mode=TwoWay}" PlaceholderText="Dst port"/>
                                        <ComboBox Grid.Column="8" ItemsSource="{x:Bind local:GenerateTab.LogOptions}"
                                                  SelectedItem="{x:Bind Log, Mode=TwoWay}"/>
                                        <Button Grid.Column="9" Content="Remove" Click="RemoveAclEntry_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Content="Add Entry" Click="AddAclEntry_Click" HorizontalAlignment="Left" Style="{StaticResource ChipButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- ===================== OSPF ===================== -->
            <Border Style="{StaticResource ToolInputPanelStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="OSPF" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Process ID" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="OspfProcessInput" Grid.Column="1" PlaceholderText="e.g. 1"/>
                        <TextBlock x:Name="OspfRouterIdLabel" Grid.Column="2" Text="Router ID" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="OspfRouterIdInput" Grid.Column="3" PlaceholderText="Optional"/>
                        <TextBlock x:Name="OspfRefBwLabel" Grid.Row="1" Grid.Column="0" Text="Ref. Bandwidth" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="OspfRefBwInput" Grid.Row="1" Grid.Column="1" PlaceholderText="Default 100"/>
                        <TextBlock x:Name="OspfPassiveLabel" Grid.Row="1" Grid.Column="2" Text="Passive Interfaces" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="OspfPassiveInput" Grid.Row="1" Grid.Column="3" PlaceholderText="Comma-separated"/>
                    </Grid>
                    <TextBlock Text="Networks — one per line: network,wildcard,area" Style="{StaticResource FieldLabelTextStyle}"/>
                    <TextBox x:Name="OspfNetworksInput" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                             PlaceholderText="10.0.0.0,0.0.0.255,0"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="OSPF is included only when a process ID is set."/>
                </StackPanel>
            </Border>

            <!-- ===================== BGP ===================== -->
            <Border Style="{StaticResource ToolInputPanelStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="BGP" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="8" RowDefinitions="Auto,Auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Local AS" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="BgpAsInput" Grid.Column="1" PlaceholderText="e.g. 65000"/>
                        <TextBlock x:Name="BgpRouterIdLabel" Grid.Column="2" Text="Router ID" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="BgpRouterIdInput" Grid.Column="3" PlaceholderText="Optional"/>
                    </Grid>
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel MinWidth="760">
                            <Grid ColumnDefinitions="150,90,*,140,70,88" ColumnSpacing="8" Margin="0,0,0,6">
                                <TextBlock Text="NEIGHBOR" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="REMOTE AS" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="2" Text="DESCRIPTION" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="3" Text="UPDATE SOURCE" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="4" Text="HOPS" Style="{StaticResource TableHeaderTextStyle}"/>
                            </Grid>
                            <ItemsControl x:Name="BgpNeighborRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:TemplateBgpNeighbor">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{x:Bind IpAddress, Mode=TwoWay}" PlaceholderText="Neighbor IP"/>
                                        <TextBox Grid.Column="1" Text="{x:Bind RemoteAs, Mode=TwoWay}" PlaceholderText="Remote AS"/>
                                        <TextBox Grid.Column="2" Text="{x:Bind Description, Mode=TwoWay}" PlaceholderText="Description"/>
                                        <TextBox Grid.Column="3" Text="{x:Bind UpdateSource, Mode=TwoWay}" PlaceholderText="Update source"/>
                                        <TextBox Grid.Column="4" Text="{x:Bind EbgpMultihop, Mode=TwoWay}" PlaceholderText="Multihop"/>
                                        <Button Grid.Column="5" Content="Remove" Click="RemoveBgpNeighbor_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Content="Add Neighbor" Click="AddBgpNeighbor_Click" HorizontalAlignment="Left" Style="{StaticResource ChipButtonStyle}"/>
                    <TextBlock Text="Networks — one per line" Style="{StaticResource FieldLabelTextStyle}"/>
                    <TextBox x:Name="BgpNetworksInput" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                             PlaceholderText="10.0.0.0/8"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="BGP is included only when a local AS is set. Neighbor rows need both an IP and a remote AS."/>
                </StackPanel>
            </Border>

            <!-- ===================== EIGRP ===================== -->
            <Border Style="{StaticResource ToolInputPanelStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="EIGRP" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="AS Number" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="EigrpAsInput" Grid.Column="1" PlaceholderText="e.g. 100"/>
                        <TextBlock x:Name="EigrpRouterIdLabel" Grid.Column="2" Text="Router ID" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="EigrpRouterIdInput" Grid.Column="3" PlaceholderText="Optional"/>
                        <CheckBox x:Name="EigrpNamedModeCheck" Grid.Row="1" Grid.Column="0" Content="Named Mode"/>
                        <TextBox x:Name="EigrpNameInput" Grid.Row="1" Grid.Column="1" PlaceholderText="Process name (default EIGRP_PROCESS)"/>
                        <TextBlock x:Name="EigrpPassiveLabel" Grid.Row="1" Grid.Column="2" Text="Passive Interfaces" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="EigrpPassiveInput" Grid.Row="1" Grid.Column="3" PlaceholderText="Comma-separated"/>
                    </Grid>
                    <TextBlock Text="Networks — one per line: network[,wildcard]" Style="{StaticResource FieldLabelTextStyle}"/>
                    <TextBox x:Name="EigrpNetworksInput" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                             PlaceholderText="10.0.0.0,0.0.0.255"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="EIGRP is included only when an AS number is set."/>
                </StackPanel>
            </Border>

            <!-- ===================== STP ===================== -->
            <Border Style="{StaticResource ToolInputPanelStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Spanning Tree Protocol" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mode" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <ComboBox x:Name="StpModeCombo" Grid.Column="1" ItemsSource="{x:Bind local:GenerateTab.StpModeOptions}" SelectedIndex="0"/>
                        <TextBlock x:Name="StpPriorityLabel" Grid.Column="2" Text="Priority" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="StpPriorityInput" Grid.Column="3" PlaceholderText="e.g. 4096"/>
                        <TextBlock x:Name="StpRootPrimaryLabel" Grid.Row="1" Grid.Column="0" Text="Root Primary VLANs" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="StpRootPrimaryInput" Grid.Row="1" Grid.Column="1" PlaceholderText="Comma-separated"/>
                        <TextBlock x:Name="StpRootSecondaryLabel" Grid.Row="1" Grid.Column="2" Text="Root Secondary VLANs" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="StpRootSecondaryInput" Grid.Row="1" Grid.Column="3" PlaceholderText="Comma-separated"/>
                        <CheckBox x:Name="StpPortfastCheck" Grid.Row="2" Grid.Column="0" Content="Portfast Default" VerticalAlignment="Center"/>
                        <CheckBox x:Name="StpBpduguardCheck" Grid.Row="2" Grid.Column="2" Content="BPDU Guard Default" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="STP is included only when at least one option is configured."/>
                </StackPanel>
            </Border>

            </StackPanel>

            <!-- ===================== Output ===================== -->
            <Border x:Name="OutputWorkbench" Grid.Column="1" Style="{StaticResource ToolInputPanelStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="GENERATED OUTPUT" Style="{StaticResource SectionLabelTextStyle}"/>
                        <TextBlock Text="Configuration and validation findings appear here." Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                    <Border x:Name="OutputEmptyState" Style="{StaticResource EmptyStatePanelStyle}" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon Glyph="&#xE943;" FontSize="18" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Ready to generate" FontWeight="SemiBold"/>
                                <TextBlock Text="Complete device basics, expand optional features as needed, then use Ctrl+Enter or Generate configuration." Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="GeneratedResultPanel" Visibility="Collapsed" Spacing="10">
                    <controls:CodeBlockView x:Name="GenerateOutput" Visibility="Collapsed" IsTabStop="True" AutomationProperties.Name="Generated configuration"/>
                    <TextBlock x:Name="ValidationSummaryText" Style="{StaticResource FieldLabelTextStyle}" Visibility="Collapsed"/>
                    <ListView x:Name="ValidationList" Visibility="Collapsed" SelectionMode="None" Background="Transparent" ItemContainerStyle="{StaticResource DenseTableItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="{ThemeResource RadiusPill}" Padding="10,2" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Grid>
                                            <Border Background="{Binding SeverityBrush}" Opacity="0.16" CornerRadius="{ThemeResource RadiusPill}"/>
                                            <TextBlock Text="{Binding Severity}" Style="{StaticResource BadgeTextStyle}" FontWeight="SemiBold"
                                                       Foreground="{Binding SeverityBrush}" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource MonoTextStyle}" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Recommendation}" Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
            </ScrollViewer>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
