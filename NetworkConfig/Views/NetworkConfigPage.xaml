<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="networker.NetworkConfig.Views.NetworkConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:networker.Controls">

    <Grid Padding="20,16,20,12" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Network Config" Style="{StaticResource SectionHeaderTextStyle}"/>
            <TextBlock Style="{StaticResource CaptionTextStyle}"
                       Text="Generate, import, validate, and compare multi-vendor device configurations — ported from NetworkConfigPro."/>
        </StackPanel>

        <TabView Grid.Row="1" Margin="0,14,0,0" IsAddTabButtonVisible="False" TabWidthMode="Compact" VerticalAlignment="Stretch">
            <TabView.TabItems>

                <!-- ===================== Generate ===================== -->
                <TabViewItem Header="Generate">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,12" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Vendor" FontWeight="SemiBold"/>
                                <ComboBox x:Name="VendorSelector" Width="280" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="Generate a sample multi-vendor configuration to exercise the ported generator. The full device form (interfaces, VLANs, routing, ACLs, STP) lands with the Generate tab UI."/>
                            <Button Content="Generate sample configuration" Click="GenerateSample_Click" HorizontalAlignment="Left"/>
                            <controls:CodeBlockView x:Name="GenerateResult" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ===================== Import / Analyze ===================== -->
                <TabViewItem Header="Import / Analyze">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,12" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="Paste an existing configuration to parse and validate it. Requires the parser and validator services (next slices)."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ===================== Diff ===================== -->
                <TabViewItem Header="Diff">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,12" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="Compare two configurations side-by-side. Will reuse the existing TextDiff service."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ===================== Vault ===================== -->
                <TabViewItem Header="Vault">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,12" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="Encrypted storage for credentials and template variables. Requires the vault service (Windows DPAPI)."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ===================== Templates ===================== -->
                <TabViewItem Header="Templates">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,12" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="Predefined device templates (Basic Router, L3 Switch, Edge Router, ...). Requires the template library service."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

            </TabView.TabItems>
        </TabView>
    </Grid>
</Page>
