<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="networker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:networker"
    xmlns:controls="using:networker.Controls"
    Title="Networker Copilot">

    <Grid x:Name="Root" x:FieldModifier="public" RowDefinitions="*,Auto">

        <Grid.Resources>
            <controls:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <controls:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True"/>
        </Grid.Resources>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="PaletteAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F5" Invoked="RefreshHealthAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>

        <!-- ======================= Navigation ======================= -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="0"
            ItemInvoked="NavView_ItemInvoked"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="232"
            CompactPaneLength="48"
            Background="{ThemeResource AppBackgroundBrush}">

            <NavigationView.MenuItemContainerStyle>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="MinHeight" Value="34"/>
                    <Setter Property="Margin" Value="4,1"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="FontSize" Value="{ThemeResource FontSizeBody}"/>
                </Style>
            </NavigationView.MenuItemContainerStyle>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" Icon="Home">
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
                <NavigationViewItem Content="Assistant" Tag="assistant" Icon="Message">
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
                <NavigationViewItem Content="Tools" Tag="tools" Icon="World">
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
                <NavigationViewItem Content="Network Config" Tag="networkconfig">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting">
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Grid
                    MinHeight="48"
                    Padding="12,6,12,10"
                    ToolTipService.ToolTip="Networker - local-first network assistant">
                    <FontIcon
                        Glyph="&#xE943;"
                        FontSize="16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                        Visibility="{Binding IsPaneOpen, ElementName=NavView, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <StackPanel
                        Spacing="1"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsPaneOpen, ElementName=NavView, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Networker" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                        <TextBlock Text="Local-first network assistant" Style="{StaticResource CaptionTextStyle}" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <!-- ======================= Status bar ======================= -->
        <Grid
            Grid.Row="1"
            Padding="10,5,12,5"
            ColumnDefinitions="*,Auto"
            Background="{ThemeResource AppBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,1,0,0">

            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="AI provider connection status">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{ThemeResource AppTextDisabledBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Not checked" Style="{StaticResource CaptionTextStyle}" MaxWidth="200" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="1" Width="1" Height="14" Background="{ThemeResource AppBorderBrush}"/>
                <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" ToolTipService.ToolTip="Active provider and model">
                    <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="StatusProviderText" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                        <TextBlock Text="/" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource AppTextDisabledBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusModelText" Grid.Column="2" Style="{StaticResource CaptionTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button
                    x:Name="StatusRefreshButton"
                    Style="{StaticResource IconButtonStyle}"
                    Width="30" Height="30"
                    Click="StatusRefreshButton_Click"
                    ToolTipService.ToolTip="Check connection (Ctrl+F5)"
                    AutomationProperties.Name="Check AI provider connection">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
                <Button
                    x:Name="StatusThemeButton"
                    Style="{StaticResource IconButtonStyle}"
                    Width="30" Height="30"
                    Click="ThemeButton_Click"
                    ToolTipService.ToolTip="Toggle light / dark theme"
                    AutomationProperties.Name="Toggle theme">
                    <FontIcon Glyph="&#xE790;" FontSize="14"/>
                </Button>
                <Border Style="{StaticResource KbdStyle}" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Ctrl" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBlock Text="K" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBlock Text="Commands" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource AppTextDisabledBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ======================= Overlay (toasts + palette) ======================= -->
        <Grid
            x:Name="OverlayHost"
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Background="Transparent">
            <StackPanel
                x:Name="ToastHost"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,8,0"
                Spacing="0"
                IsHitTestVisible="True"/>
            <controls:CommandPalette x:Name="Palette" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
