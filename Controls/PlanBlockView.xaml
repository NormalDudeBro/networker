<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="networker.Controls.PlanBlockView"
    x:Name="PlanViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:networker.Models"
    xmlns:local="using:networker.Controls">

    <UserControl.Resources>
        <local:PlanStatusBrushConverter x:Key="PlanBrush"/>
        <local:PlanRunningWeightConverter x:Key="PlanWeight"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource AppInsetBrush}"
        BorderBrush="{ThemeResource AppBorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Margin="0,0,0,8"
        Padding="12,8">
        <StackPanel Spacing="4">

            <!-- Header: plan icon + summary + running spinner -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <FontIcon Glyph="&#xE9D2;" FontSize="13" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center"/>
                <TextBlock
                    Grid.Column="1"
                    Text="Plan"
                    Style="{StaticResource FieldLabelTextStyle}"
                    FontSize="12"
                    VerticalAlignment="Center"/>
                <TextBlock
                    Grid.Column="2"
                    Text="{Binding SummaryText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextStyle}"
                    FontSize="11"
                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"/>
                <ProgressRing
                    Grid.Column="3"
                    IsActive="{Binding IsRunning, Mode=OneWay}"
                    Width="12"
                    Height="12"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- Rows -->
            <ItemsControl ItemsSource="{Binding Items, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PlanItem">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,2">
                            <FontIcon
                                Glyph="{Binding StatusGlyph, Mode=OneWay}"
                                FontSize="11"
                                VerticalAlignment="Center"
                                Foreground="{Binding Status, Mode=OneWay, Converter={StaticResource PlanBrush}}"/>
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Title, Mode=OneWay}"
                                Style="{StaticResource MonoSecondaryTextStyle}"
                                FontSize="12"
                                TextWrapping="Wrap"
                                FontWeight="{Binding Status, Mode=OneWay, Converter={StaticResource PlanWeight}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
