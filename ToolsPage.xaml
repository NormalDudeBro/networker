<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="networker.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource AppBackgroundBrush}" Padding="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="480">
            <FontIcon Glyph="&#xE774;" FontSize="40" Foreground="{ThemeResource AppAccentBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Network Toolkit" Style="{StaticResource SectionHeaderTextStyle}" HorizontalAlignment="Center"/>
            <TextBlock Style="{StaticResource CaptionTextStyle}" TextAlignment="Center"
                       Text="Deterministic networking tools are being wired in: IP calculator, configuration generation and audit, diffs, troubleshooting playbooks, log analysis, topology diagrams, and vendor translation."/>
        </StackPanel>
    </Grid>
</Page>
