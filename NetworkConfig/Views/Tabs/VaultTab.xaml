<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="networker.NetworkConfig.Views.Tabs.VaultTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,12" Spacing="12" MaxWidth="840" HorizontalAlignment="Left">

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Vault Status" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock x:Name="VaultStatusText" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PasswordBox x:Name="VaultPasswordInput" Width="280" PlaceholderText="Master password"/>
                        <Button x:Name="VaultUnlockButton" Content="Unlock" Style="{StaticResource PrimaryButtonStyle}" Click="UnlockOrCreate_Click"/>
                        <Button x:Name="VaultLockButton" Content="Lock" Click="Lock_Click" IsEnabled="False"/>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="The vault encrypts stored data with AES-256-GCM, keyed by your master password (PBKDF2-SHA256). No plaintext ever touches disk."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Stored Credentials" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBox x:Name="CredsList" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="130"
                             FontFamily="{ThemeResource CodeFontFamily}" FontSize="{ThemeResource FontSizeCode}"
                             Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CredNameInput" PlaceholderText="Name (e.g. router-admin)"/>
                        <TextBox x:Name="CredUserInput" Grid.Column="1" PlaceholderText="Username"/>
                        <PasswordBox x:Name="CredPassInput" Grid.Column="2" PlaceholderText="Password"/>
                        <TextBox x:Name="CredDescInput" Grid.Column="3" PlaceholderText="Description"/>
                    </Grid>
                    <Button Content="Add Credential" Style="{StaticResource PrimaryButtonStyle}" Click="AddCredential_Click" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="DelCredNameInput" Width="240" PlaceholderText="Credential name to delete"/>
                        <Button Content="Delete" Click="DeleteCredential_Click" Style="{StaticResource DangerButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Stored Variables" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBox x:Name="VarsList" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                             FontFamily="{ThemeResource CodeFontFamily}" FontSize="{ThemeResource FontSizeCode}"
                             Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="VarNameInput" Width="220" PlaceholderText="Variable name (e.g. SNMP_COMMUNITY)"/>
                        <TextBox x:Name="VarValueInput" Width="240" PlaceholderText="Value"/>
                        <ComboBox x:Name="VarSecretCombo" Width="120" SelectedIndex="0">
                            <x:String>Normal</x:String>
                            <x:String>Secret</x:String>
                        </ComboBox>
                        <Button Content="Add Variable" Style="{StaticResource PrimaryButtonStyle}" Click="AddVariable_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
