<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="networker.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:networker.Controls"
    xmlns:models="using:networker.Models"
    xmlns:local="using:networker"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:ChatMessage">
            <StackPanel HorizontalAlignment="Right" Spacing="4" Margin="0,0,0,12" MaxWidth="720">
                <Border Style="{StaticResource UserBubbleStyle}">
                    <TextBlock Style="{StaticResource UserBubbleTextStyle}" Text="{x:Bind Text}"/>
                </Border>
                <TextBlock Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" FontSize="11">
                    <Run Text="You"/><Run Text=" · "/><Run Text="{x:Bind Timestamp, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="models:ChatMessage">
            <StackPanel Spacing="6" Margin="0,0,0,16" MaxWidth="760">
                <TextBlock Style="{StaticResource CaptionTextStyle}" FontSize="11">
                    <Run Text="Assistant"/>
                    <Run Text="{x:Bind Provider, Mode=OneWay}" Foreground="{ThemeResource AppAccentBrush}"/>
                    <Run Text="{x:Bind Model, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock
                    Style="{StaticResource AssistantMessageTextStyle}"
                    Text="{x:Bind Text, Mode=OneWay}"/>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind IsStreaming, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressRing IsActive="True" Width="12" Height="12"/>
                    <TextBlock Text="Generating…" Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CodeMessageTemplate" x:DataType="models:ChatMessage">
            <StackPanel Spacing="4" Margin="0,0,0,16" MaxWidth="860" HorizontalAlignment="Left">
                <controls:CodeBlockView/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ErrorMessageTemplate" x:DataType="models:ChatMessage">
            <Border
                Margin="0,0,0,16"
                MaxWidth="720"
                HorizontalAlignment="Left"
                Background="{ThemeResource BadgeDangerBackgroundBrush}"
                BorderBrush="{ThemeResource AppDangerBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource RadiusMD}"
                Padding="14,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="Request failed" FontWeight="SemiBold" Foreground="{ThemeResource AppDangerBrush}"/>
                    <TextBlock Style="{StaticResource AssistantMessageTextStyle}" Text="{x:Bind Text}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <controls:MessageTemplateSelector
            x:Key="MessageSelector"
            UserTemplate="{StaticResource UserMessageTemplate}"
            AssistantTemplate="{StaticResource AssistantMessageTemplate}"
            CodeTemplate="{StaticResource CodeMessageTemplate}"
            ErrorTemplate="{StaticResource ErrorMessageTemplate}"/>

        <controls:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <controls:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================= Header ======================= -->
        <Grid
            Grid.Row="0" Grid.Column="0"
            Padding="20,14,20,12"
            ColumnDefinitions="*,Auto"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Assistant" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Style="{StaticResource CaptionTextStyle}"
                    Text="Chat with your configured AI provider. Deterministic tools run locally; the model explains and assists."/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button
                    x:Name="PanelToggleButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="PanelToggleButton_Click"
                    ToolTipService.ToolTip="Toggle history panel"
                    AutomationProperties.Name="Toggle history panel">
                    <FontIcon Glyph="&#xE8E7;" FontSize="16"/>
                </Button>
                <Button
                    x:Name="NewChatButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="NewChatButton_Click"
                    ToolTipService.ToolTip="New chat"
                    AutomationProperties.Name="New chat">
                    <FontIcon Glyph="&#xE8BD;" FontSize="16"/>
                </Button>
                <Button
                    x:Name="ClearHistoryButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="ClearHistoryButton_Click"
                    ToolTipService.ToolTip="Clear history"
                    AutomationProperties.Name="Clear history">
                    <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================= Chat area ======================= -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <Border
                        Width="72" Height="72"
                        CornerRadius="20"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE8BD;" FontSize="32"
                            Foreground="{ThemeResource AppAccentBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Start a conversation" Style="{StaticResource SectionHeaderTextStyle}" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        TextAlignment="Center"
                        MaxWidth="480"
                        Text="Ask about network configs, troubleshooting, IP math, or log analysis. Deterministic tools run first; the model explains the results."/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Style="{StaticResource ChipButtonStyle}" Content="Calculate a subnet" Click="QuickStart_Click" Tag="ip"/>
                        <Button Style="{StaticResource ChipButtonStyle}" Content="Generate OSPF config" Click="QuickStart_Click" Tag="ospf"/>
                        <Button Style="{StaticResource ChipButtonStyle}" Content="Audit a config" Click="QuickStart_Click" Tag="audit"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ListView
                x:Name="MessagesList"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="False"
                ItemTemplateSelector="{StaticResource MessageSelector}"
                Padding="32,16,32,8"
                Background="Transparent"/>
        </Grid>

        <!-- ======================= Quick actions ======================= -->
        <ScrollViewer
            Grid.Row="2" Grid.Column="0"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Enabled">
            <StackPanel x:Name="QuickActionsRow" Orientation="Horizontal" Spacing="8" Padding="20,4,20,4">
                <TextBlock Text="Quick actions:" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource ChipButtonStyle}" Content="Subnet calc" Click="RunTool_Click" Tag="ip"/>
                <Button Style="{StaticResource ChipButtonStyle}" Content="OSPF config" Click="RunTool_Click" Tag="ospf"/>
                <Button Style="{StaticResource ChipButtonStyle}" Content="BGP config" Click="RunTool_Click" Tag="bgp"/>
                <Button Style="{StaticResource ChipButtonStyle}" Content="Audit config" Click="RunTool_Click" Tag="audit"/>
                <Button Style="{StaticResource ChipButtonStyle}" Content="Analyze logs" Click="RunTool_Click" Tag="logs"/>
                <Button Style="{StaticResource ChipButtonStyle}" Content="Topology" Click="RunTool_Click" Tag="topology"/>
                <Button Style="{StaticResource ChipButtonStyle}" Content="Translate" Click="RunTool_Click" Tag="translate"/>
                <Button Style="{StaticResource ChipButtonStyle}" Content="Playbook" Click="RunTool_Click" Tag="playbook"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================= Input ======================= -->
        <Grid Grid.Row="3" Grid.Column="0" Padding="20,8,20,16">
            <Border
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource RadiusMD}"
                Padding="8,6">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox
                        x:Name="InputBox"
                        Grid.Column="0"
                        PlaceholderText="Ask about network engineering… (Ctrl+Enter to send)"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        TextChanged="InputBox_TextChanged"
                        KeyDown="InputBox_KeyDown"
                        MinHeight="36"
                        MaxHeight="160"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        BorderThickness="0"
                        Background="Transparent"/>
                    <Button
                        x:Name="CancelButton"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Style="{StaticResource IconButtonStyle}"
                        Click="CancelButton_Click"
                        ToolTipService.ToolTip="Stop generation"
                        AutomationProperties.Name="Stop generation">
                        <FontIcon Glyph="&#xE711;" FontSize="14"/>
                    </Button>
                    <Button
                        x:Name="SendButton"
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        Click="SendButton_Click"
                        ToolTipService.ToolTip="Send (Ctrl+Enter)"
                        AutomationProperties.Name="Send message"
                        Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE724;" FontSize="14"/>
                            <TextBlock Text="Send" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= Session panel ======================= -->
        <Grid
            x:Name="AssistantPanel"
            Grid.Row="1" Grid.RowSpan="3" Grid.Column="1"
            Width="320"
            Visibility="Collapsed"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="16" Spacing="14">
                    <TextBlock Text="Session" Style="{StaticResource SectionHeaderTextStyle}"/>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Provider" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ProviderComboBox" SelectionChanged="ProviderComboBox_SelectionChanged" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Model" FontWeight="SemiBold"/>
                            <ProgressRing x:Name="ModelLoadingRing" IsActive="False" Width="16" Height="16"/>
                        </StackPanel>
                        <ComboBox x:Name="ModelComboBox" SelectionChanged="ModelComboBox_SelectionChanged" HorizontalAlignment="Stretch" IsEnabled="False"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="PanelHealthDot" Width="8" Height="8" Fill="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PanelHealthText" Text="Not checked" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ChipButtonStyle}" Content="Check" Click="HealthCheckButton_Click" HorizontalAlignment="Right" Padding="10,4"/>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource AppBorderBrush}"/>

                    <StackPanel Spacing="5">
                        <TextBlock Text="History" FontWeight="SemiBold"/>
                        <TextBox x:Name="HistorySearchBox" PlaceholderText="Search messages…" TextChanged="HistorySearchBox_TextChanged"/>
                        <ListView x:Name="HistoryList" MaxHeight="160" SelectionMode="Single" ItemClick="HistoryList_ItemClick" IsItemClickEnabled="True">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ChatMessage">
                                    <TextBlock Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="13"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="Clear history" Click="ClearHistoryButton_Click" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
